---
import { Icon } from 'astro-icon/components'
import Title from './Title.astro'
import { getCollection } from 'astro:content'

const allProjects = await getCollection('projects')
// Backend, app y admin del mismo producto cuentan como uno solo.
const productCount = new Set(allProjects.map((p) => p.data.product ?? p.slug)).size

const stats = [
    { icon: 'ph:briefcase', label: 'Experiencia', value: 9, prefix: '+', suffix: ' años', note: 'Full‑Stack' },
    { icon: 'ph:stack', label: 'Productos', value: productCount, prefix: '+', suffix: '', note: 'Web · Móvil · IA' },
]

const timeline = [
    {
        area: 'Retail',
        title: 'Retail Suite',
        text: 'Sistema multi‑tenant con integraciones a SAP y VTEX, marcaciones y vacantes. Desarrollo en VTEX IO.',
    },
    {
        area: 'Delivery',
        title: 'Vipper',
        text: 'Plataforma tipo Uber Eats con React Native, NestJS y SvelteKit.',
    },
    {
        area: 'Educación',
        title: 'UBE · ITB',
        text: 'Chatbots con IA para la Universidad Bolivariana del Ecuador y apps con Kotlin Multiplatform para ITB Nóminas y el SGA.',
    },
    {
        area: 'Productos propios',
        title: 'Snappli · Linkeate · MarkNotes',
        text: 'SaaS y apps que diseño, construyo y despliego de punta a punta, incluido el Simulador ANT.',
    },
]
---

<section
    id="about-me"
    class="seccion w-full flex justify-center px-6 md:px-9 py-16 md:py-24 fade-in">
    <div class="w-full max-w-5xl flex flex-col gap-8 md:gap-10">
        <Title label="Acerca de mí" subtitle="Quién soy y en qué he trabajado." />

        <div class="flex flex-col gap-8 md:gap-10 w-full">
            <div class="flex flex-col md:flex-row items-center gap-6 md:gap-8">
            <img
                src="/static/luis-gomez.webp"
                alt="Foto de Luis Gómez"
                width="460"
                height="460"
                loading="lazy"
                decoding="async"
                class="w-32 h-32 sm:w-40 sm:h-40 md:w-44 md:h-44 shrink-0 rounded-full object-cover
                       ring-4 ring-primary-light/20 dark:ring-primary-dark/25
                       border-4 border-surface-light dark:border-surface-dark shadow-md" />
            <div class="stagger grid grid-cols-3 gap-2.5 sm:gap-4 w-full flex-1">
                {stats.map((s) => (
                    <div
                        class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3
                               text-center sm:text-left items-center
                               p-3 sm:p-5 rounded-2xl
                               bg-surfaceContainer-light/50 dark:bg-surfaceContainer-dark/30
                               border border-outline-light/20 dark:border-outline-dark/30">
                        <Icon name={s.icon} class="w-6 h-6 sm:w-7 sm:h-7 text-secondary-light dark:text-secondary-dark shrink-0" aria-hidden="true" />
                        <div class="min-w-0">
                            <h3 class="text-sm sm:text-base font-semibold text-onSurface-light dark:text-onSurface-dark">
                                {s.label}
                            </h3>
                            <p class="text-sm font-medium text-onSurface-light dark:text-onSurface-dark tabular-nums">
                                {s.prefix}<span data-count-to={s.value}>{s.value}</span>{s.suffix}
                            </p>
                            <p class="text-[11px] sm:text-xs text-outline-light dark:text-outline-dark leading-snug">
                                {s.note}
                            </p>
                        </div>
                    </div>
                ))}
                <div
                    class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3
                           text-center sm:text-left items-center
                           p-3 sm:p-5 rounded-2xl
                           bg-surfaceContainer-light/50 dark:bg-surfaceContainer-dark/30
                           border border-outline-light/20 dark:border-outline-dark/30">
                    <Icon name="ph:graduation-cap" class="w-6 h-6 sm:w-7 sm:h-7 text-secondary-light dark:text-secondary-dark shrink-0" aria-hidden="true" />
                    <div class="min-w-0">
                        <h3 class="text-sm sm:text-base font-semibold text-onSurface-light dark:text-onSurface-dark">
                            Educación
                        </h3>
                        <p class="text-sm font-medium text-onSurface-light dark:text-onSurface-dark">Ing. Sistemas</p>
                        <p class="text-[11px] sm:text-xs text-outline-light dark:text-outline-dark leading-snug">
                            UPS · 2019
                        </p>
                    </div>
                </div>
            </div>
            </div>

            <ol class="stagger relative grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-5">
                {timeline.map((item) => (
                    <li
                        class="relative flex gap-4 p-5 rounded-2xl
                               bg-surfaceContainer-light/30 dark:bg-surfaceContainer-dark/20
                               border border-outline-light/15 dark:border-outline-dark/25">
                        <span class="mt-1.5 w-2.5 h-2.5 shrink-0 rounded-full bg-primary-light dark:bg-primary-dark
                                     ring-4 ring-primary-light/15 dark:ring-primary-dark/20" aria-hidden="true"></span>
                        <div class="flex flex-col gap-1 min-w-0">
                            <span class="text-[11px] font-medium tracking-[0.12em] uppercase text-primary-light dark:text-primary-dark">
                                {item.area}
                            </span>
                            <h3 class="font-semibold text-onSurface-light dark:text-onSurface-dark">{item.title}</h3>
                            <p class="text-sm leading-relaxed text-outline-light dark:text-outline-dark">{item.text}</p>
                        </div>
                    </li>
                ))}
            </ol>

            <p class="text-sm md:text-base leading-relaxed text-onSurface-light dark:text-onSurface-dark text-center max-w-2xl mx-auto">
                Me importa el código claro, el despliegue estable y que cada pieza resuelva un problema concreto.
                Fuera del teclado: fotografía, básquet y carpintería.
            </p>
        </div>
    </div>
</section>

<script>
    function initCounters() {
        const els = document.querySelectorAll<HTMLElement>('[data-count-to]');
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion || !els.length) return;

        const run = (el: HTMLElement) => {
            const target = Number(el.dataset.countTo);
            const duration = 1400;
            const start = performance.now();
            const tick = (now: number) => {
                const t = Math.min((now - start) / duration, 1);
                const eased = 1 - Math.pow(1 - t, 3);
                el.textContent = String(Math.round(target * eased));
                if (t < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                run(entry.target as HTMLElement);
                observer.unobserve(entry.target);
            });
        }, { threshold: 0.6 });

        els.forEach((el) => {
            el.textContent = '0';
            observer.observe(el);
        });
    }

    document.addEventListener('astro:page-load', initCounters);
</script>
