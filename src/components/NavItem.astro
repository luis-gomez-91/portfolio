---
interface Props {
	html: string;
	href: string;
	dataNav?: string;
}

const { html, href, dataNav } = Astro.props;
---

<a 
    href={href}
    data-nav={dataNav ?? undefined}
    class="nav-link relative px-2.5 py-1.5 text-sm font-medium
        text-outline-light dark:text-outline-dark 
        hover:text-onSurface-light dark:hover:text-onSurface-dark
        transition-colors duration-200 ease-out"
>
    {html}
</a>