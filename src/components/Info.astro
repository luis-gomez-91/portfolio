---
import { Icon } from 'astro-icon/components'
import IconItem from './IconItem.astro'

const name = 'Luis Gómez'
const roles = ['Full‑Stack Developer', 'Founder @ Flow Solutions Technology', 'AI & SaaS Architect']

const heroTechs = [
	'python', 'django', 'flask', 'fastapi', 'react', 'nextdotjs', 'svelte', 'nestjs',
	'postgresql', 'redis', 'typescript', 'javascript', 'kotlin', 'docker', 'astro',
	'tailwindcss', 'langchain',
]
---

<section class="hero relative w-full min-h-[100svh] flex items-center overflow-hidden">
	<div id="hero-techs" class="hero-techs absolute inset-0 z-0 pointer-events-none select-none" aria-hidden="true">
		{
			heroTechs.map((tech) => (
				<span class="hero-tech" data-tech={tech}>
					<span class="hero-tech-layer">
						<Icon name={`simple-icons:${tech}`} />
					</span>
				</span>
			))
		}
	</div>

	<div class="hero-layout relative z-10 w-full max-w-3xl mx-auto px-6 md:px-9 pt-24 md:pt-28 pb-16 md:pb-24
				flex flex-col items-center text-center">
		<p class="hero-badge inline-flex items-center gap-2 px-3 py-1.5 mb-5 rounded-full text-xs font-medium
				  text-onSurface-light dark:text-onSurface-dark
				  bg-surfaceContainer-light/80 dark:bg-surfaceContainer-dark/80
				  border border-outline-light/20 dark:border-outline-dark/25 backdrop-blur-sm">
			<span class="hero-dot" aria-hidden="true"></span>
			<span>Disponible para proyectos</span>
			<span class="text-outline-light dark:text-outline-dark" aria-hidden="true">·</span>
			<span class="text-outline-light dark:text-outline-dark">Guayaquil, Ecuador<span class="hidden sm:inline"> · Remoto</span></span>
		</p>

		<p class="hero-kicker min-h-[1.25rem] text-xs sm:text-sm font-medium tracking-[0.1em] sm:tracking-[0.14em] uppercase whitespace-nowrap
				  text-primary-light dark:text-primary-dark">
			<span id="hero-role" class="hero-role" data-roles={JSON.stringify(roles)}>{roles[0]}</span><span class="hero-caret" aria-hidden="true"></span>
		</p>

		<h1 class="hero-name font-suse font-bold leading-[0.95] tracking-tight
				   text-onSurface-light dark:text-onSurface-dark
				   text-[clamp(2.75rem,10vw,5.5rem)] mt-3" aria-label={name}>
			{name.split('').map((ch, i) => (
				<span class="hero-letter" aria-hidden="true" style={`animation-delay:${0.12 + i * 0.045}s`}>{ch === ' ' ? '\u00A0' : ch}</span>
			))}
		</h1>

		<p class="hero-headline font-suse font-semibold text-lg md:text-xl
				  text-tertiary-light dark:text-tertiary-dark max-w-md leading-snug mt-4">
			+9 años construyendo sistemas para retail, educación y SaaS propios
		</p>

		<p class="hero-sub text-sm md:text-lg text-outline-light dark:text-outline-dark max-w-lg
				  leading-relaxed mt-4">
			Convierto procesos manuales en software que los equipos usan todos los días.
		</p>


		<div class="hero-cta flex flex-col sm:flex-row gap-3 sm:gap-4 w-full sm:w-auto justify-center mt-8">
			<a
				href="#projects"
				class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full
					   text-white dark:text-[#0c1a33]
					   bg-primary-light dark:bg-primary-dark
					   hover:brightness-110
					   transition-all duration-200 ease-out
					   hover:scale-[1.03] active:scale-[0.98]
					   shadow-md shadow-primary-light/25 dark:shadow-primary-dark/20">
				<span>Ver proyectos</span>
				<Icon name="ph:arrow-right-bold" class="w-[18px] h-[18px]" aria-hidden="true" />
			</a>
			<a
				href="#contacts"
				class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full
					   text-primary-light dark:text-primary-dark
					   bg-transparent border-2 border-primary-light/50 dark:border-primary-dark/50
					   hover:bg-primary-light/10 dark:hover:bg-primary-dark/10
					   hover:border-primary-light dark:hover:border-primary-dark
					   transition-all duration-200 ease-out
					   hover:scale-[1.03] active:scale-[0.98]">
				Contactar
			</a>
		</div>

		<div class="hero-meta flex flex-wrap items-center justify-center gap-x-5 gap-y-3 mt-8">
			<a
				href="/static/Luis_Gomez_Veloz_CV.pdf"
				download="Luis-Gomez-CV.pdf"
				class="text-sm text-outline-light dark:text-outline-dark
					   hover:text-onSurface-light dark:hover:text-onSurface-dark
					   underline underline-offset-4 decoration-outline-light/40 dark:decoration-outline-dark/40
					   hover:decoration-onSurface-light dark:hover:decoration-onSurface-dark
					   transition-colors duration-200">
				Descargar CV
			</a>
			<div class="flex gap-5">
				<IconItem href="https://github.com/luis-gomez-91" icon="simple-icons:github" label="GitHub" />
				<IconItem href="https://www.linkedin.com/in/luisgomez1991/" icon="simple-icons:linkedin" label="LinkedIn" />
			</div>
		</div>
	</div>
</section>

<script>
	function initHeroTechs() {
		const container = document.getElementById('hero-techs');
		if (!container || container.dataset.bound === '1') return;
		container.dataset.bound = '1';

		const icons = Array.from(container.querySelectorAll('.hero-tech'));
		if (!icons.length) return;

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const timers = [];

		const MOVE_MS = 10000;
		const SIZE = '2.2rem';
		const OPACITY = '0.16';

		const rand = (min, max) => min + Math.random() * (max - min);

		/** Posiciones que priorizan bordes para no tapar el texto central. */
		function randomEdgePosition() {
			const band = Math.random();
			if (band < 0.25) return { x: rand(2, 96), y: rand(4, 22) }; // top
			if (band < 0.5) return { x: rand(2, 96), y: rand(78, 94) }; // bottom
			if (band < 0.75) return { x: rand(2, 16), y: rand(18, 82) }; // left
			return { x: rand(84, 96), y: rand(18, 82) }; // right
		}

		// Movimiento por cuadro (rAF): permite acelerar según la velocidad del mouse.
		// Cada icono recorre un tramo del borde en MOVE_MS (a velocidad normal).
		const MAX_BOOST = 6; // velocidad máxima = 1 + MAX_BOOST veces la normal
		const items = icons.map((el) => {
			const from = randomEdgePosition();
			el.style.width = SIZE;
			el.style.height = SIZE;
			el.style.opacity = OPACITY;
			el.style.left = `${from.x}%`;
			el.style.top = `${from.y}%`;
			// Progreso inicial aleatorio para que no cambien de rumbo todos a la vez.
			return { el, from, to: randomEdgePosition(), t: Math.random() };
		});

		let boost = 0; // aceleración actual (suavizada)
		let boostTarget = 0; // aceleración pedida por el mouse
		let raf = 0;
		let last = 0;

		function tick(now) {
			// Tope a dt para que no "salten" al volver de una pestaña oculta.
			const dt = Math.min(now - (last || now), 50);
			last = now;

			// El impulso del mouse se desvanece; la velocidad lo sigue con suavidad.
			boostTarget *= Math.exp(-dt / 350);
			boost += (boostTarget - boost) * (1 - Math.exp(-dt / 120));

			const step = (dt * (1 + boost)) / MOVE_MS;
			items.forEach((it) => {
				it.t += step;
				if (it.t >= 1) {
					it.from = it.to;
					it.to = randomEdgePosition();
					it.t = 0;
				}
				const x = it.from.x + (it.to.x - it.from.x) * it.t;
				const y = it.from.y + (it.to.y - it.from.y) * it.t;
				it.el.style.left = `${x}%`;
				it.el.style.top = `${y}%`;
			});
			raf = requestAnimationFrame(tick);
		}
		if (!reduceMotion) raf = requestAnimationFrame(tick);

		// Velocidad del mouse dentro del hero → acelera los iconos.
		const hero = container.closest('section');
		let lastPointer = null;
		const onHeroMove = (e) => {
			const now = performance.now();
			if (lastPointer) {
				const elapsed = Math.max(now - lastPointer.time, 1);
				const dist = Math.hypot(e.clientX - lastPointer.x, e.clientY - lastPointer.y);
				const speed = dist / elapsed; // px/ms (lento ~0.2, rápido ~3+)
				boostTarget = Math.max(boostTarget, Math.min(speed * 2, MAX_BOOST));
			}
			lastPointer = { x: e.clientX, y: e.clientY, time: now };
		};
		const onHeroLeave = () => { lastPointer = null; };

		// Parallax con el mouse: cada icono tiene una profundidad distinta.
		const layers = icons.map((el) => ({
			el: el.querySelector('.hero-tech-layer'),
			depth: rand(12, 40),
		}));
		const finePointer = window.matchMedia('(pointer: fine)').matches;
		let frame = 0;
		const onMove = (e) => {
			if (frame) return;
			frame = requestAnimationFrame(() => {
				frame = 0;
				const dx = e.clientX / window.innerWidth - 0.5;
				const dy = e.clientY / window.innerHeight - 0.5;
				layers.forEach(({ el, depth }) => {
					if (el) el.style.transform = `translate3d(${-dx * depth}px, ${-dy * depth}px, 0)`;
				});
			});
		};
		if (finePointer && !reduceMotion) {
			window.addEventListener('pointermove', onMove, { passive: true });
			hero?.addEventListener('pointermove', onHeroMove, { passive: true });
			hero?.addEventListener('pointerleave', onHeroLeave);
		}

		// Rol rotativo con efecto de máquina de escribir.
		const roleEl = document.getElementById('hero-role');
		const roles = roleEl ? JSON.parse(roleEl.dataset.roles || '[]') : [];
		if (roleEl && roles.length > 1 && !reduceMotion) {
			let index = 0;
			const typeNext = () => {
				const current = roles[index];
				index = (index + 1) % roles.length;
				const next = roles[index];
				let text = current;
				const erase = () => {
					text = text.slice(0, -1);
					roleEl.textContent = text;
					if (text.length) timers.push(window.setTimeout(erase, 45));
					else timers.push(window.setTimeout(write, 200));
				};
				let i = 0;
				const write = () => {
					i++;
					roleEl.textContent = next.slice(0, i);
					if (i < next.length) timers.push(window.setTimeout(write, 80));
					else timers.push(window.setTimeout(typeNext, 2400));
				};
				erase();
			};
			timers.push(window.setTimeout(typeNext, 2600));
		}

		document.addEventListener(
			'astro:before-swap',
			() => {
				timers.forEach((id) => clearTimeout(id));
				cancelAnimationFrame(raf);
				hero?.removeEventListener('pointermove', onHeroMove);
				hero?.removeEventListener('pointerleave', onHeroLeave);
				window.removeEventListener('pointermove', onMove);
				container.dataset.bound = '0';
			},
			{ once: true }
		);
	}

	document.addEventListener('astro:page-load', initHeroTechs);
	initHeroTechs();
</script>

<style>
	.hero-tech {
		position: absolute;
		display: block;
		width: 2.2rem;
		height: 2.2rem;
		opacity: 0;
		transform: translate(-50%, -50%);
		will-change: left, top;
	}

	.hero-tech-layer {
		display: block;
		width: 100%;
		height: 100%;
		transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
		will-change: transform;
	}

	.hero-tech svg {
		display: block;
		width: 100%;
		height: 100%;
		color: #5b6070;
	}

	:global(html.dark) .hero-tech svg {
		color: #c4c7d0;
	}

	@media (max-width: 767px) {
		.hero-tech {
			width: 2.2rem;
			height: 2.2rem;
		}
	}

	.hero-letter {
		display: inline-block;
		animation: hero-letter 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	@keyframes hero-letter {
		from {
			opacity: 0;
			transform: translateY(0.4em) rotate(4deg);
			filter: blur(6px);
		}
		to {
			opacity: 1;
			transform: none;
			filter: blur(0);
		}
	}

	.hero-caret {
		display: inline-block;
		width: 2px;
		height: 1em;
		margin-left: 3px;
		vertical-align: -0.15em;
		background: currentColor;
		animation: hero-caret 1s steps(1) infinite;
	}

	@keyframes hero-caret {
		50% { opacity: 0; }
	}

	.hero-badge,
	.hero-kicker,
	.hero-headline,
	.hero-sub,
	.hero-cta,
	.hero-meta {
		animation: hero-rise 0.75s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.hero-kicker { animation-delay: 0.05s; }
	.hero-headline { animation-delay: 0.5s; }
	.hero-sub { animation-delay: 0.6s; }
	.hero-cta { animation-delay: 0.7s; }
	.hero-meta { animation-delay: 0.8s; }

	/* Punto verde de disponibilidad con pulso suave. */
	.hero-dot {
		position: relative;
		width: 8px;
		height: 8px;
		border-radius: 9999px;
		background: #22c55e;
	}
	.hero-dot::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: inherit;
		animation: hero-ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
	}
	@keyframes hero-ping {
		75%, 100% { transform: scale(2.4); opacity: 0; }
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-dot::after,
		.hero-badge,
			.hero-letter,
		.hero-caret,
		.hero-kicker,
		.hero-headline,
		.hero-sub,
		.hero-cta,
		.hero-meta {
			animation: none !important;
		}
	}
</style>
