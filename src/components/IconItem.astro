---
interface Props {
    href:string,
    clase:string
}

const { href, clase } = Astro.props
---

<a 
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class="
        hover:text-primary-light dark:hover:text-primary-dark
        focus:animate-jump
        transition-colors duration-300 ease-linear" 
>
    <span class={`${clase} text-3xl md:text-[2rem]`}></span>
</a>