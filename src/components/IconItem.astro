---
import { Icon } from 'astro-icon/components'

interface Props {
	href: string;
	/** Nombre Iconify, p. ej. 'simple-icons:github'. */
	icon: string;
	label: string;
}

const { href, icon, label } = Astro.props
---

<a
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	aria-label={label}
	title={label}
	class="inline-flex text-outline-light dark:text-outline-dark
	       hover:text-primary-light dark:hover:text-primary-dark
	       focus:animate-jump
	       transition-colors duration-300 ease-linear">
	<Icon name={icon} class="w-7 h-7 md:w-8 md:h-8" aria-hidden="true" />
</a>
