---
import { Icon } from 'astro-icon/components'
import { demoLink, metaLine, placeholderHue, placeholderIcon, type ProjectGroup } from '../lib/projects'

interface Props {
    group: ProjectGroup;
    /** Tarjeta principal del bento: la imagen crece para llenar el alto. */
    large?: boolean;
}

const MAX_TECH = 4;

const { group, large = false } = Astro.props;
const { primary, parts, title, image, areas, technologies } = group;
const { description, previewLink = '', githubLink = '' } = primary.data;
const href = `/${primary.slug}`;
const multi = parts.length > 1;
const demo = previewLink ? demoLink(previewLink, primary.data.areas) : null;
// Con varias piezas hay varios repos: el detalle los muestra todos.
const github = multi ? '' : githubLink;
const meta = metaLine(primary);
const extraTech = technologies.length - MAX_TECH;
const hue = placeholderHue(group.key);
---

<div data-tilt class="tilt-card group relative h-full flex flex-col rounded-2xl overflow-hidden
            bg-surfaceContainer-light/50 dark:bg-surfaceContainer-dark/30
            border border-outline-light/20 dark:border-outline-dark/30
            shadow-sm
            transition-all duration-300 ease-out
            hover:border-secondary-light/40 hover:dark:border-secondary-dark/40
            hover:shadow-md
            focus-within:border-secondary-light/60 focus-within:dark:border-secondary-dark/60">
    <a href={href} class="block flex-1 flex flex-col min-h-0 focus:outline-none">
        <div class:list={[
            'relative w-full overflow-hidden bg-outline-light/10 dark:bg-outline-dark/10',
            large ? 'aspect-[16/10] lg:aspect-auto lg:flex-1 lg:min-h-[18rem]' : 'aspect-[16/10]',
        ]}>
            {image ? (
                <img
                    src={image}
                    alt={`Captura de ${title}`}
                    width="600"
                    height="400"
                    loading="lazy"
                    decoding="async"
                    transition:name={`project-image-${primary.slug}`}
                    class:list={['w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out', large && 'object-left-top']}>
            ) : (
                <div
                    class="project-placeholder w-full h-full flex flex-col items-center justify-center gap-3 p-6 text-center"
                    style={`--ph-hue: ${hue}`}
                    transition:name={`project-image-${primary.slug}`}>
                    <Icon name={placeholderIcon(areas)} class="w-12 h-12 opacity-80" aria-hidden="true" />
                    <span class="font-suse font-bold text-xl md:text-2xl leading-tight line-clamp-2">{title}</span>
                </div>
            )}
            {multi && (
                <span class="absolute top-3 left-3 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium
                             bg-surface-light/90 dark:bg-surface-dark/90 text-onSurface-light dark:text-onSurface-dark backdrop-blur shadow-sm">
                    <Icon name="ph:stack" class="w-3.5 h-3.5" aria-hidden="true" />
                    {parts.length} piezas
                </span>
            )}
        </div>
        <div class:list={['p-5 flex flex-col', !large && 'flex-1']}>
            {meta && (
                <p class="mb-1.5 inline-flex items-center gap-1.5 text-xs font-medium uppercase tracking-wide text-tertiary-light dark:text-tertiary-dark">
                    {group.kind && <span class:list={['kind-dot', `kind-dot-${group.kind}`]} aria-hidden="true"></span>}
                    {meta}
                </p>
            )}
            <h3 transition:name={`project-title-${primary.slug}`} class:list={['text-onSurface-light dark:text-onSurface-dark font-semibold line-clamp-2', large ? 'text-xl md:text-2xl' : 'text-lg md:text-xl']}>
                {title}
            </h3>
            {multi && (
                <p class="mt-1 text-xs text-outline-light dark:text-outline-dark">
                    {parts.map((p) => p.data.part ?? p.data.title).join(' · ')}
                </p>
            )}
            {description.trim() && (
                <p class="mt-2 text-sm text-outline-light dark:text-outline-dark line-clamp-2">
                    {description.trim()}
                </p>
            )}
            {technologies.length > 0 && (
                <ul class="flex flex-wrap gap-1.5 mt-3" aria-label="Tecnologías">
                    {technologies.slice(0, MAX_TECH).map((tech) => (
                        <li class="px-2 py-0.5 rounded-md text-xs bg-secondaryContainer-light dark:bg-secondaryContainer-dark text-secondary-light dark:text-secondary-dark">
                            {tech}
                        </li>
                    ))}
                    {extraTech > 0 && (
                        <li class="px-2 py-0.5 rounded-md text-xs border border-outline-light/30 dark:border-outline-dark/40 text-outline-light dark:text-outline-dark"
                            title={technologies.slice(MAX_TECH).join(', ')}>
                            +{extraTech}
                        </li>
                    )}
                </ul>
            )}
        </div>
    </a>
    {(demo || github) && (
        <div class="flex flex-row flex-wrap gap-2 justify-end items-center px-5 pb-5 pt-4 border-t border-outline-light/10 dark:border-outline-dark/10">
            {github && (
                <a
                    href={github}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Ver código de ${title} (se abre en otra pestaña)`}
                    title="Ver código"
                    class="inline-flex items-center justify-center w-10 h-10 rounded-full
                           text-secondary-light dark:text-secondary-dark
                           bg-transparent border border-secondary-light/60 dark:border-secondary-dark/60
                           hover:bg-secondary-light/15 hover:dark:bg-secondary-dark/15
                           hover:border-secondary-light dark:hover:border-secondary-dark
                           active:scale-95
                           transition-all duration-200 ease-out">
                    <Icon name="simple-icons:github" class="w-5 h-5" aria-hidden="true" />
                </a>
            )}
            {demo && (
                <a
                    href={previewLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${demo.label}: ${title} (se abre en otra pestaña)`}
                    title={demo.label}
                    class="inline-flex items-center justify-center w-10 h-10 rounded-full
                           text-secondaryContainer-light dark:text-secondaryContainer-dark
                           bg-secondary-light dark:bg-secondary-dark
                           hover:bg-secondary-light/90 hover:dark:bg-secondary-dark/90
                           active:scale-95
                           transition-all duration-200 ease-out">
                    <Icon name={demo.icon} class="w-5 h-5" aria-hidden="true" />
                </a>
            )}
        </div>
    )}
    <span class="tilt-glow pointer-events-none absolute inset-0 rounded-2xl opacity-0 transition-opacity duration-300" aria-hidden="true"></span>
</div>

<style>
    .project-placeholder {
        color: hsl(var(--ph-hue) 35% 30%);
        background:
            radial-gradient(circle at 20% 15%, hsl(var(--ph-hue) 70% 88%), transparent 55%),
            radial-gradient(circle at 85% 90%, hsl(calc(var(--ph-hue) + 40) 60% 85%), transparent 50%),
            hsl(var(--ph-hue) 40% 93%);
    }
    :global(html.dark) .project-placeholder {
        color: hsl(var(--ph-hue) 60% 85%);
        background:
            radial-gradient(circle at 20% 15%, hsl(var(--ph-hue) 45% 30%), transparent 55%),
            radial-gradient(circle at 85% 90%, hsl(calc(var(--ph-hue) + 40) 40% 25%), transparent 50%),
            hsl(var(--ph-hue) 25% 18%);
    }
</style>
