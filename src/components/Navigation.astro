---
import Theme from './Theme.astro';
import NavItem from './NavItem.astro';

const mobileLinks = [
    {
        href: '/',
        label: 'Inicio',
        dataNav: 'inicio',
        // Phosphor House
        icon: 'M218.83,103.77l-80-75.48a1.14,1.14,0,0,0-.11-.11,16,16,0,0,0-21.53,0l-.11.11L37.17,103.77A16,16,0,0,0,32,115.55V208a16,16,0,0,0,16,16H96a16,16,0,0,0,16-16V160h32v48a16,16,0,0,0,16,16h48a16,16,0,0,0,16-16V115.55A16,16,0,0,0,218.83,103.77ZM208,208H160V160a16,16,0,0,0-16-16H112a16,16,0,0,0-16,16v48H48V115.55l.11-.1L128,40l79.9,75.43.11.1Z',
    },
    {
        href: '/projects',
        label: 'Proyectos',
        dataNav: 'projects',
        // Phosphor SquaresFour
        icon: 'M104,40H56A16,16,0,0,0,40,56v48a16,16,0,0,0,16,16h48a16,16,0,0,0,16-16V56A16,16,0,0,0,104,40Zm0,64H56V56h48v48Zm96-64H152a16,16,0,0,0-16,16v48a16,16,0,0,0,16,16h48a16,16,0,0,0,16-16V56A16,16,0,0,0,200,40Zm0,64H152V56h48v48Zm-96,32H56a16,16,0,0,0-16,16v48a16,16,0,0,0,16,16h48a16,16,0,0,0,16-16V152A16,16,0,0,0,104,136Zm0,64H56V152h48v48Zm96-64H152a16,16,0,0,0-16,16v48a16,16,0,0,0,16,16h48a16,16,0,0,0,16-16V152A16,16,0,0,0,200,136Zm0,64H152V152h48v48Z',
    },
    {
        href: '/#about-me',
        label: 'Acerca de mí',
        dataNav: 'about',
        // Phosphor User
        icon: 'M230.92,212c-15.23-26.33-38.7-45.21-66.09-54.16a72,72,0,1,0-73.66,0C63.78,166.78,40.31,185.66,25.08,212a8,8,0,1,0,13.85,8c18.84-32.56,52.14-52,89.07-52s70.23,19.44,89.07,52a8,8,0,1,0,13.85-8ZM72,96a56,56,0,1,1,56,56A56.06,56.06,0,0,1,72,96Z',
    },
    {
        href: '/#skills',
        label: 'Habilidades',
        dataNav: 'skills',
        // Phosphor Lightning
        icon: 'M215.79,118.17a8,8,0,0,0-5-5.66L153.18,90.9l14.66-73.33a8,8,0,0,0-13.69-7l-112,120a8,8,0,0,0,3,13l57.63,21.61L88.16,238.43a8,8,0,0,0,13.69,7l112-120A8,8,0,0,0,215.79,118.17ZM109.37,214l10.47-52.38a8,8,0,0,0-5-9.06L62,132.71l84.62-90.66L136.23,94.43a8,8,0,0,0,5,9.06l52.8,19.8Z',
    },
    {
        href: '#contacts',
        label: 'Contactos',
        dataNav: 'contacts',
        // Phosphor EnvelopeSimple
        icon: 'M224,48H32a8,8,0,0,0-8,8V192a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A8,8,0,0,0,224,48Zm-8,144H40V74.19l82.59,75.71a8,8,0,0,0,10.82,0L216,74.19V192Z',
    },
];
---

<nav class="site-nav fixed top-0 inset-x-0 z-50 flex justify-center px-4 md:px-6" aria-label="Principal">
    <div
        class="nav-shell mt-3 flex w-full max-w-6xl items-center justify-between gap-4 rounded-2xl
               bg-surface-light/80 dark:bg-surface-dark/80
               border border-outline-light/10 dark:border-outline-dark/10
               shadow-md backdrop-blur px-4 py-2 md:px-6 md:py-3">

        <!-- Marca -->
        <a href="/" class="flex items-center gap-3 relative z-[60]">
            <div
                class="flex h-10 w-10 items-center justify-center rounded-full
                       bg-secondaryContainer-light dark:bg-secondaryContainer-dark
                       text-secondary-light dark:text-secondary-dark font-semibold text-base"
                aria-hidden="true">
                LG
            </div>
            <div class="hidden sm:flex flex-col leading-tight">
                <span class="text-sm font-semibold text-onSurface-light dark:text-onSurface-dark">
                    Luis Gómez
                </span>
                <span class="text-xs text-outline-light dark:text-outline-dark">
                    Desarrollador Full‑Stack
                </span>
            </div>
        </a>

        <!-- Links desktop -->
        <div
            id="nav-links"
            class="hidden md:flex items-center gap-1 transition-all duration-300 ease-in-out">
            <NavItem html="Inicio" href="/" dataNav="inicio" />
            <NavItem html="Proyectos" href="/projects" dataNav="projects" />
            <NavItem html="Acerca de mí" href="/#about-me" dataNav="about" />
            <NavItem html="Habilidades" href="/#skills" dataNav="skills" />
            <NavItem html="Contactos" href="#contacts" dataNav="contacts" />
        </div>

        <!-- Tema + menú móvil -->
        <div class="flex items-center gap-2 md:gap-3 relative z-[60]">
            <div class="flex w-[40px] h-[40px]
                       bg-[rgb(218,226,249,0.4)] dark:bg-[rgba(62,71,89,0.4)]
                       hover:bg-secondaryContainer-light hover:dark:bg-secondaryContainer-dark
                       rounded-full transition-colors duration-200 ease-linear overflow-hidden">
                <Theme />
            </div>

            <button
                id="menu-toggle"
                type="button"
                class="menu-toggle md:hidden w-[44px] h-[44px] flex items-center justify-center
                       bg-[rgb(218,226,249,0.7)] dark:bg-[rgba(62,71,89,0.7)]
                       hover:bg-secondaryContainer-light hover:dark:bg-secondaryContainer-dark
                       rounded-full transition-colors duration-200 ease-linear
                       focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2
                       focus-visible:outline-secondary-light dark:focus-visible:outline-secondary-dark"
                aria-expanded="false"
                aria-controls="mobile-menu"
                aria-label="Abrir menú">
                <span class="burger" aria-hidden="true">
                    <span class="burger-line"></span>
                    <span class="burger-line"></span>
                    <span class="burger-line"></span>
                </span>
            </button>
        </div>
    </div>
</nav>

<!-- Overlay + panel móvil (fuera del shell para no recortar) -->
<div
    id="mobile-menu"
    class="mobile-menu md:hidden"
    hidden
    aria-hidden="true">
    <button
        type="button"
        class="mobile-backdrop"
        id="menu-backdrop"
        aria-label="Cerrar menú"
        tabindex="-1">
    </button>

    <div class="mobile-panel" role="dialog" aria-modal="true" aria-label="Navegación">
        <nav class="mobile-nav" aria-label="Menú móvil">
            <ul class="mobile-list">
                {mobileLinks.map((link, i) => (
                    <li style={`--i: ${i}`}>
                        <a
                            href={link.href}
                            data-nav={link.dataNav}
                            class="nav-link mobile-link">
                            <span class="mobile-link-icon" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" width="20" height="20">
                                    <path d={link.icon}></path>
                                </svg>
                            </span>
                            <span class="mobile-link-label">{link.label}</span>
                            <span class="mobile-link-chevron" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" width="16" height="16">
                                    <path d="M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z"></path>
                                </svg>
                            </span>
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    </div>
</div>

<script>
    function updateNavActive() {
        const path = window.location.pathname;
        const hash = window.location.hash || '';
        let active = 'inicio';

        if (path !== '/' && path !== '') {
            active = 'projects';
        } else if (hash === '#about-me') {
            active = 'about';
        } else if (hash === '#skills' || hash === '#soft-skills') {
            active = 'skills';
        } else if (hash === '#contacts') {
            active = 'contacts';
        } else if (hash === '#projects') {
            active = 'projects';
        }

        document.querySelectorAll('.nav-link').forEach((link) => {
            const isActive = link.getAttribute('data-nav') === active;
            link.classList.toggle('nav-active', isActive);
        });
    }

    function setNavActiveByKey(key) {
        if (!key) return;
        document.querySelectorAll('.nav-link').forEach((link) => {
            link.classList.toggle('nav-active', link.getAttribute('data-nav') === key);
        });
    }

    // Feedback inmediato al clic (View Transitions / smooth-scroll no siempre actualizan a tiempo)
    document.addEventListener('click', (e) => {
        const el = e.target instanceof Element ? e.target : null;
        const link = el?.closest('.nav-link');
        if (!link) return;
        setNavActiveByKey(link.getAttribute('data-nav'));
    });

    // Con View Transitions hay que re-sincronizar en cada navegación, no solo en DOMContentLoaded
    document.addEventListener('astro:page-load', updateNavActive);
    document.addEventListener('astro:after-swap', updateNavActive);
    window.addEventListener('hashchange', updateNavActive);
    window.addEventListener('popstate', updateNavActive);

    document.addEventListener('astro:page-load', () => {
        const menuToggle = document.getElementById('menu-toggle');
        const mobileMenu = document.getElementById('mobile-menu');
        const backdrop = document.getElementById('menu-backdrop');

        if (menuToggle?.dataset.navBound === '1') return;
        if (menuToggle) menuToggle.dataset.navBound = '1';

        function openMenu() {
            if (!mobileMenu || !menuToggle) return;
            mobileMenu.hidden = false;
            void mobileMenu.offsetWidth;
            mobileMenu.classList.add('is-open');
            mobileMenu.setAttribute('aria-hidden', 'false');
            menuToggle.setAttribute('aria-expanded', 'true');
            menuToggle.setAttribute('aria-label', 'Cerrar menú');
            menuToggle.classList.add('is-open');
            document.documentElement.classList.add('menu-lock');
        }

        function closeMenu() {
            if (!mobileMenu || !menuToggle) return;
            if (mobileMenu.hidden) return;
            mobileMenu.classList.remove('is-open');
            mobileMenu.setAttribute('aria-hidden', 'true');
            menuToggle.setAttribute('aria-expanded', 'false');
            menuToggle.setAttribute('aria-label', 'Abrir menú');
            menuToggle.classList.remove('is-open');
            document.documentElement.classList.remove('menu-lock');

            const panel = mobileMenu.querySelector('.mobile-panel');
            const onEnd = () => {
                mobileMenu.hidden = true;
                panel?.removeEventListener('transitionend', onEnd);
            };
            panel?.addEventListener('transitionend', onEnd);
            setTimeout(() => {
                if (!mobileMenu.classList.contains('is-open')) {
                    mobileMenu.hidden = true;
                }
            }, 400);
        }

        if (menuToggle && mobileMenu) {
            menuToggle.addEventListener('click', (e) => {
                e.stopPropagation();
                if (mobileMenu.classList.contains('is-open')) {
                    closeMenu();
                } else {
                    openMenu();
                }
            });

            mobileMenu.querySelectorAll('a').forEach((link) => {
                link.addEventListener('click', () => closeMenu());
            });
        }

        backdrop?.addEventListener('click', () => closeMenu());

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeMenu();
        });

        const nav = document.querySelector('.site-nav');
        const shell = document.querySelector('.nav-shell');

        const handleScroll = () => {
            const scrolled = window.scrollY > 8;
            shell?.classList.toggle('nav-scrolled', scrolled);
            nav?.classList.toggle('site-nav-scrolled', scrolled);
        };

        handleScroll();
        window.addEventListener('scroll', handleScroll, { passive: true });
    });
</script>

<style>
    /* —— Burger → X —— */
    .burger {
        position: relative;
        display: block;
        width: 18px;
        height: 14px;
    }

    .burger-line {
        position: absolute;
        left: 0;
        display: block;
        width: 100%;
        height: 2px;
        border-radius: 2px;
        background-color: #3e4759;
        transform-origin: center;
        transition:
            transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
            opacity 0.2s ease,
            background-color 0.2s ease;
    }

    .burger-line:nth-child(1) { top: 0; }
    .burger-line:nth-child(2) { top: 6px; }
    .burger-line:nth-child(3) { top: 12px; }

    :global(html.dark) .burger-line {
        background-color: #c2c6d4;
    }

    .menu-toggle.is-open .burger-line:nth-child(1) {
        transform: translateY(6px) rotate(45deg);
    }

    .menu-toggle.is-open .burger-line:nth-child(2) {
        opacity: 0;
        transform: scaleX(0);
    }

    .menu-toggle.is-open .burger-line:nth-child(3) {
        transform: translateY(-6px) rotate(-45deg);
    }

    /* —— Mobile overlay —— */
    .mobile-menu {
        position: fixed;
        inset: 0;
        z-index: 40;
        pointer-events: none;
    }

    .mobile-menu.is-open {
        pointer-events: auto;
    }

    .mobile-backdrop {
        position: absolute;
        inset: 0;
        border: 0;
        padding: 0;
        margin: 0;
        cursor: pointer;
        background: rgba(26, 29, 36, 0.45);
        backdrop-filter: blur(4px);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .mobile-menu.is-open .mobile-backdrop {
        opacity: 1;
    }

    .mobile-panel {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        padding:
            calc(4.75rem + env(safe-area-inset-top, 0px))
            0.75rem
            calc(1.5rem + env(safe-area-inset-bottom, 0px));
        background:
            linear-gradient(
                165deg,
                rgba(249, 249, 255, 0.98) 0%,
                rgba(241, 244, 252, 0.98) 55%,
                rgba(236, 240, 250, 0.98) 100%
            );
        border-bottom: 1px solid rgba(116, 119, 127, 0.12);
        border-radius: 0 0 1.5rem 1.5rem;
        box-shadow: 0 18px 40px rgba(17, 19, 24, 0.12);
        transform: translateY(-12px);
        opacity: 0;
        transition:
            transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
            opacity 0.28s ease;
    }

    :global(html.dark) .mobile-panel {
        background:
            linear-gradient(
                165deg,
                rgba(26, 29, 36, 0.98) 0%,
                rgba(30, 33, 41, 0.98) 55%,
                rgba(34, 38, 46, 0.98) 100%
            );
        border-bottom-color: rgba(142, 144, 153, 0.2);
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
    }

    .mobile-menu.is-open .mobile-panel {
        transform: translateY(0);
        opacity: 1;
    }

    .mobile-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        width: 100%;
    }

    .mobile-list li {
        width: 100%;
        opacity: 0;
        transform: translateY(10px);
        transition:
            opacity 0.35s ease,
            transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
        transition-delay: 0s;
    }

    .mobile-menu.is-open .mobile-list li {
        opacity: 1;
        transform: translateY(0);
        transition-delay: calc(0.06s + var(--i) * 0.05s);
    }

    .mobile-link {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        width: 100%;
        padding: 0.75rem 0.85rem;
        border-radius: 0.85rem;
        text-decoration: none;
        color: #3e4759;
        transition:
            background-color 0.2s ease,
            color 0.2s ease;
    }

    :global(html.dark) .mobile-link {
        color: #c2c6d4;
    }

    .mobile-link:hover,
    .mobile-link:focus-visible {
        background-color: rgba(218, 226, 249, 0.55);
        color: #191c20;
        outline: none;
    }

    :global(html.dark) .mobile-link:hover,
    :global(html.dark) .mobile-link:focus-visible {
        background-color: rgba(62, 71, 89, 0.55);
        color: #e2e2e9;
    }

    .mobile-link-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 1.35rem;
        height: 1.35rem;
        color: inherit;
    }

    .mobile-link-label {
        flex: 1;
        font-size: 0.95rem;
        font-weight: 500;
        letter-spacing: -0.01em;
        line-height: 1.3;
        min-width: 0;
    }

    .mobile-link-chevron {
        flex-shrink: 0;
        opacity: 0.35;
        display: flex;
        transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .mobile-link:hover .mobile-link-chevron,
    .mobile-link:focus-visible .mobile-link-chevron,
    .mobile-link.nav-active .mobile-link-chevron {
        opacity: 0.7;
        transform: translateX(2px);
    }

    .mobile-link.nav-active {
        background-color: rgba(218, 226, 249, 0.7);
        color: #191c20;
    }

    :global(html.dark) .mobile-link.nav-active {
        background-color: rgba(62, 71, 89, 0.7);
        color: #e2e2e9;
    }

    /* Bloqueo de scroll con menú abierto */
    :global(html.menu-lock),
    :global(html.menu-lock body) {
        overflow: hidden;
    }

    /* Transición suave del contenedor del nav al hacer scroll */
    .site-nav {
        pointer-events: none;
    }

    .site-nav .nav-shell {
        pointer-events: auto;
        transition:
            margin-top 0.25s ease,
            border-radius 0.25s ease,
            max-width 0.25s ease,
            background-color 0.25s ease,
            border-color 0.25s ease,
            box-shadow 0.25s ease,
            padding 0.25s ease;
    }

    .nav-shell.nav-scrolled {
        margin-top: 0;
        max-width: 100%;
        border-radius: 0;
        box-shadow: 0 2px 18px rgba(0, 0, 0, 0.16);
        background-color: rgba(249, 249, 255, 0.98);
        border-color: rgba(116, 119, 127, 0.18);
        padding-block: 0.4rem;
    }

    :global(html.dark) .nav-shell.nav-scrolled {
        background-color: rgba(26, 29, 36, 0.98);
        border-color: rgba(142, 144, 153, 0.4);
        box-shadow: 0 2px 18px rgba(0, 0, 0, 0.4);
    }

    /* Desktop: activo con peso + subrayado, sin pastilla tipo select */
    :global(#nav-links .nav-link.nav-active) {
        color: #191c20;
        font-weight: 600;
    }

    :global(html.dark #nav-links .nav-link.nav-active) {
        color: #e2e2e9;
    }

    :global(#nav-links .nav-link.nav-active)::after {
        content: '';
        position: absolute;
        left: 0.55rem;
        right: 0.55rem;
        bottom: 0.15rem;
        height: 1.5px;
        border-radius: 1px;
        background-color: #415f91;
    }

    :global(html.dark #nav-links .nav-link.nav-active)::after {
        background-color: #aac7ff;
    }
</style>
