---
import '../../public/icomoon/style.css';
import ProjectItem from './ProjectItem.astro';
import Title from './Title.astro';

import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const byPriority = (a: (typeof allProjects)[number], b: (typeof allProjects)[number]) => {
	if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
	const orderA = a.data.order ?? Number.MAX_SAFE_INTEGER;
	const orderB = b.data.order ?? Number.MAX_SAFE_INTEGER;
	if (orderA !== orderB) return orderA - orderB;
	return a.data.title.localeCompare(b.data.title, 'es');
};
const featuredProjects = allProjects.filter((project) => project.data.featured).sort(byPriority);
const projects = (featuredProjects.length > 0 ? featuredProjects : [...allProjects].sort(byPriority)).slice(0, 3);
---

<section id="projects" class="seccion flex flex-col justify-center items-center w-full px-6 md:px-9 py-16 md:py-20">
    <div class="flex flex-col justify-around items-center w-full max-w-5xl gap-1">
        <Title label="Proyectos destacados" dev={false} />
        <a
            href="/projects"
            class="text-sm md:text-base text-secondary-light dark:text-secondary-dark
                   border-b border-transparent pb-1
                   hover:border-secondary-light hover:dark:border-secondary-dark
                   transition-all duration-300 ease-in-out">
            Ver todos los proyectos →
        </a>
    </div>

    <div class="mt-10 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 w-full max-w-6xl">
        {
            projects.map((project) => {
                const { slug, data } = project;
                const { title, description, images, previewLink, githubLink, technologies = [] } = data;

                return (
                    <ProjectItem
                        slug={slug}
                        title={title}
                        description={description}
                        img={images[0]}
                        url_demo={previewLink}
                        url_github={githubLink}
                        technologies={technologies} />
                );
            })
        }
    </div>
</section>

