---
import { Icon } from 'astro-icon/components'
import SkillItem from './SkillsItem.astro'
import Title from './Title.astro'
import { brandColor } from '../lib/brand'

// Lo que uso a diario y defiendo en una entrevista.
const core = [
    { name: 'Python', icon: 'simple-icons:python', detail: 'Django · FastAPI · Flask' },
    { name: 'PostgreSQL', icon: 'simple-icons:postgresql', detail: 'Modelado, SQLAlchemy, Redis' },
    { name: 'React · Astro', icon: 'simple-icons:react', detail: 'Next.js · SvelteKit · Tailwind' },
    { name: 'TypeScript', icon: 'simple-icons:typescript', detail: 'NestJS · Frontend tipado' },
    { name: 'Kotlin Multiplatform', icon: 'simple-icons:kotlin', detail: 'Android e iOS · Compose' },
    { name: 'LangChain', icon: 'simple-icons:langchain', detail: 'LangGraph · RAG · Agentes' },
    { name: 'Docker', icon: 'simple-icons:docker', detail: 'Dokploy · Railway · Vercel' },
    { name: 'VTEX IO', icon: 'simple-icons:vtex', detail: 'Integraciones SAP · e‑commerce' },
]

// Todo lo demás, sin niveles: chips agrupados por área.
const groups = [
    {
        title: 'Backend',
        icon: 'ph:database',
        items: [
            { name: 'Django REST Framework', icon: 'simple-icons:django' },
            { name: 'NestJS', icon: 'simple-icons:nestjs' },
            { name: 'Prisma', icon: 'simple-icons:prisma' },
            { name: 'PHP', icon: 'simple-icons:php' },
            { name: 'MySQL', icon: 'simple-icons:mysql' },
            { name: 'Redis', icon: 'simple-icons:redis' },
            { name: 'JWT / OAuth', icon: 'simple-icons:jsonwebtokens' },
            { name: 'OpenAPI / Swagger', icon: 'simple-icons:swagger' },
        ],
    },
    {
        title: 'Frontend',
        icon: 'ph:browser',
        items: [
            { name: 'Next.js', icon: 'simple-icons:nextdotjs' },
            { name: 'Svelte', icon: 'simple-icons:svelte' },
            { name: 'SvelteKit', icon: 'simple-icons:svelte' },
            { name: 'Tailwind', icon: 'simple-icons:tailwindcss' },
            { name: 'shadcn/ui', icon: 'simple-icons:shadcnui' },
            { name: 'Bootstrap', icon: 'simple-icons:bootstrap' },
            { name: 'jQuery', icon: 'simple-icons:jquery' },
        ],
    },
    {
        title: 'Móvil',
        icon: 'ph:device-mobile',
        items: [
            { name: 'Jetpack Compose', icon: 'simple-icons:jetpackcompose' },
            { name: 'Ktor', icon: 'simple-icons:ktor' },
            { name: 'Koin', icon: 'simple-icons:kotlin' },
            { name: 'React Native', icon: 'simple-icons:react' },
            { name: 'Expo', icon: 'simple-icons:expo' },
            { name: 'Play Console', icon: 'simple-icons:googleplay' },
            { name: 'Xcode', icon: 'simple-icons:xcode' },
        ],
    },
    {
        title: 'IA',
        icon: 'ph:sparkle',
        items: [
            { name: 'LangGraph', icon: 'simple-icons:langgraph' },
            { name: 'RAG', icon: 'ph:files' },
            { name: 'OpenAI', icon: 'simple-icons:openai' },
            { name: 'Gemini', icon: 'simple-icons:googlegemini' },
            { name: 'Claude', icon: 'simple-icons:claude' },
            { name: 'Kimi', icon: 'simple-icons:kimi' },
            { name: 'MiniMax', icon: 'simple-icons:minimax' },
        ],
    },
    {
        title: 'Infra y monitoreo',
        icon: 'ph:hard-drives',
        items: [
            { name: 'VPS Linux', icon: 'simple-icons:linux' },
            { name: 'Dokploy', icon: 'ph:rocket-launch' },
            { name: 'GitHub Actions', icon: 'simple-icons:githubactions' },
            { name: 'Grafana', icon: 'simple-icons:grafana' },
            { name: 'VictoriaMetrics', icon: 'simple-icons:victoriametrics' },
            { name: 'Uptime Kuma', icon: 'simple-icons:uptimekuma' },
            { name: 'Cloudflare DNS', icon: 'simple-icons:cloudflare' },
            { name: 'Cloudflare R2', icon: 'simple-icons:cloudflare' },
            { name: 'Railway', icon: 'simple-icons:railway' },
            { name: 'Vercel', icon: 'simple-icons:vercel' },
            { name: 'Render', icon: 'simple-icons:render' },
        ],
    },
    {
        title: 'Servicios y pagos',
        icon: 'ph:credit-card',
        items: [
            { name: 'Paddle', icon: 'simple-icons:paddle' },
            { name: 'PayPhone', icon: 'ph:credit-card' },
            { name: 'Nuvei', icon: 'ph:credit-card' },
            { name: 'Supabase', icon: 'simple-icons:supabase' },
            { name: 'Cloudinary', icon: 'simple-icons:cloudinary' },
            { name: 'iReport', icon: 'ph:file-pdf' },
        ],
    },
]
---

<section id="skills" class="seccion flex flex-col items-center w-full px-6 md:px-9 py-16 md:py-24">
    <div class="w-full max-w-5xl flex flex-col gap-10 md:gap-12">
        <Title label="Habilidades" subtitle="El stack con el que construyo a diario y lo que sumo según el proyecto." />

        <div class="flex flex-col gap-4">
            <h3 class="text-xs font-medium tracking-[0.12em] uppercase text-primary-light dark:text-primary-dark">
                Stack principal
            </h3>
            <ul class="stagger grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
                {core.map((s) => {
                    const color = brandColor(s.icon)
                    return (
                        <li class="flex items-center gap-3 p-4 rounded-2xl
                                   bg-surfaceContainer-light/50 dark:bg-surfaceContainer-dark/30
                                   border border-outline-light/20 dark:border-outline-dark/30">
                            <span class="shrink-0 w-10 h-10 rounded-xl
                                         bg-surfaceContainer-light dark:bg-[#e8eaf0] text-[#1d2433]
                                         flex items-center justify-center">
                                <Icon name={s.icon} class="w-5 h-5" style={color ? `color:${color}` : undefined} aria-hidden="true" />
                            </span>
                            <div class="min-w-0">
                                <p class="text-sm font-semibold text-onSurface-light dark:text-onSurface-dark">{s.name}</p>
                                <p class="text-xs text-outline-light dark:text-outline-dark leading-snug">{s.detail}</p>
                            </div>
                        </li>
                    )
                })}
            </ul>
        </div>

        <div class="flex flex-col gap-4">
            <h3 class="text-xs font-medium tracking-[0.12em] uppercase text-primary-light dark:text-primary-dark">
                También trabajo con
            </h3>
            <div class="stagger grid grid-cols-1 md:grid-cols-2 gap-3 md:gap-4">
                {groups.map((g, i) => (
                    <div class={`flex flex-col gap-3 p-5 rounded-2xl
                                bg-surfaceContainer-light/30 dark:bg-surfaceContainer-dark/20
                                border border-outline-light/15 dark:border-outline-dark/25
                                ${i === groups.length - 1 && groups.length % 2 === 1 ? 'md:col-span-2' : ''}`}>
                        <h4 class="flex items-center gap-2 text-sm font-semibold text-onSurface-light dark:text-onSurface-dark">
                            <Icon name={g.icon} class="w-4 h-4 text-secondary-light dark:text-secondary-dark" aria-hidden="true" />
                            {g.title}
                        </h4>
                        <ul class="flex flex-wrap gap-2">
                            {g.items.map((item) => <SkillItem name={item.name} icon={item.icon} />)}
                        </ul>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>
