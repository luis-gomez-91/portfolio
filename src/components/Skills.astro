---
import '../../public/icomoon/style.css'
import IconItem from './IconItem.astro'
import SkillItem from './SkillsItem.astro'
import Title from './Title.astro'
---

<section id="skills" class="seccion flex flex-col justify-center items-center w-full px-6 md:px-9 py-20 md:py-24">
    <div class="flex flex-row justify-around items-center w-full max-w-5xl">
        <Title label="Habilidades" dev={true}/>
    </div>

    <div class="w-full max-w-6xl relative mt-10">
        <button type="button"
            id="scroll-left"
            class="absolute top-1/2 -translate-y-1/2 -left-4 xl:-left-6 z-50 hidden xl:flex items-center justify-center
                   w-11 h-11 rounded-full
                   bg-surfaceContainer-light/80 dark:bg-surfaceContainer-dark/60
                   border border-outline-light/20 dark:border-outline-dark/30
                   text-onSurface-light dark:text-onSurface-dark
                   hover:bg-secondaryContainer-light hover:dark:bg-secondaryContainer-dark
                   transition-colors duration-200 ease-out"
            aria-label="Anterior">
            <span class="icon-arrow-left2 text-xl"></span>
        </button>
        <button type="button"
            id="scroll-right"
            class="absolute top-1/2 -translate-y-1/2 -right-4 xl:-right-6 z-50 hidden xl:flex items-center justify-center
                   w-11 h-11 rounded-full
                   bg-surfaceContainer-light/80 dark:bg-surfaceContainer-dark/60
                   border border-outline-light/20 dark:border-outline-dark/30
                   text-onSurface-light dark:text-onSurface-dark
                   hover:bg-secondaryContainer-light hover:dark:bg-secondaryContainer-dark
                   transition-colors duration-200 ease-out"
            aria-label="Siguiente">
            <span class="icon-arrow-right2 text-xl"></span>
        </button>
        <div class="hidden xl:flex w-[24rem] h-full absolute start-[-12px] top-0 z-10 bg-gradient-to-r from-[rgb(249,249,255,1)] dark:from-[rgb(17,19,24,1)] to-transparent"></div>
        
        <div id="scroll-container" class="w-full flex flex-row gap-5 justify-start overflow-x-auto overflow-y-hidden mt-10 scroll-smooth snap-x snap-mandatory scrollbar-hide pb-2">
            <div class="hidden xl:flex min-w-[12rem] max-w-[28rem] min-h-[20rem]"></div>
            <div class="min-w-[16rem] md:min-w-[22rem] max-w-[28rem] min-h-[20rem] p-5 rounded-2xl overflow-hidden flex flex-col items-center snap-center
                       bg-surfaceContainer-light/50 dark:bg-surfaceContainer-dark/30
                       border border-outline-light/20 dark:border-outline-dark/30 shadow-sm">
                <h3 class="text-base font-semibold text-onSurface-light dark:text-onSurface-dark">Desarrollo Backend</h3>
                <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-3">
                    <SkillItem name="Python" nivel="Avanzado" />
                    <SkillItem name="PHP" nivel="Intermedio" />
                    <SkillItem name="Django" nivel="Avanzado" />
                    <SkillItem name="Django Rest Framework" nivel="Intermedio" />
                    <SkillItem name="FastApi" nivel="Avanzado" />
                    <SkillItem name="Flask" nivel="Avanzado" />
                    <SkillItem name="Laravel" nivel="Básico" />
                    <SkillItem name="PostgreSQL" nivel="Avanzado" />
                    <SkillItem name="MySQL" nivel="Avanzado" />
                    <SkillItem name="Oracle" nivel="Básico" />
                    <SkillItem name="SQLAlchemy" icon="SQL" nivel="Intermedio" />
                    <SkillItem name="JWT" nivel="Avanzado" />
                    <SkillItem name="OAuth" icon="Authentication" nivel="Intermedio" />
                    <SkillItem name="Swagger" nivel="Avanzado" />
                    <SkillItem name="Redoc" nivel="Intermedio" />
                    <SkillItem name="NestJS" nivel="Básico" />
                    <SkillItem name="Prisma" nivel="Básico" />
                </div>
            </div>
    
            <div class="min-w-[16rem] md:min-w-[22rem] max-w-[28rem] min-h-[20rem] p-5 rounded-2xl overflow-hidden flex flex-col items-center snap-center
                       bg-surfaceContainer-light/50 dark:bg-surfaceContainer-dark/30
                       border border-outline-light/20 dark:border-outline-dark/30 shadow-sm">
                <h3 class="text-base font-semibold text-onSurface-light dark:text-onSurface-dark">Desarrollo Frontend</h3>
                <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-3">
                    <SkillItem name="Astro" nivel="Avanzado" />
                    <SkillItem name="React" nivel="Avanzado" />
                    <SkillItem name="NextJS" nivel="Intermedio" />
                    <SkillItem name="Shadcn" icon="UI" nivel="Intermedio" />
                    <SkillItem name="TypeScript" nivel="Intermedio" />
                    <SkillItem name="Tailwind" nivel="Avanzado" />
                    <SkillItem name="Bootstrap" nivel="Avanzado" />
                    <SkillItem name="JavaScript" nivel="Avanzado" />
                    <SkillItem name="JQuery" nivel="Avanzado" />
                    <SkillItem name="HTML5" nivel="Avanzado" />
                    <SkillItem name="CSS" nivel="Avanzado" />
                </div>
            </div>
    
            <div class="min-w-[16rem] md:min-w-[22rem] max-w-[28rem] min-h-[20rem] p-5 rounded-2xl overflow-hidden flex flex-col items-center snap-center
                       bg-surfaceContainer-light/50 dark:bg-surfaceContainer-dark/30
                       border border-outline-light/20 dark:border-outline-dark/30 shadow-sm">
                <h3 class="text-base font-semibold text-onSurface-light dark:text-onSurface-dark">Desarrollo Móvil</h3>
                <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-3">
                    <SkillItem name="Kotlin" nivel="Avanzado" />
                    <SkillItem name="Java" nivel="Básico" />
                    <SkillItem name="Jetpack Compose" nivel="Avanzado" />
                    <SkillItem name="Kotlin Multiplatform" nivel="Avanzado" />
                    <SkillItem name="Material3" nivel="Avanzado" />
                    <SkillItem name="Ktor" nivel="Intermedio" />
                    <SkillItem name="Koin" icon="Kotlin" nivel="Intermedio" />
                    <SkillItem name="Android Studio (IDE)" nivel="Avanzado" />
                </div>
            </div>
    
            <div class="min-w-[16rem] md:min-w-[22rem] max-w-[28rem] min-h-[20rem] p-5 rounded-2xl overflow-hidden flex flex-col items-center snap-center
                       bg-surfaceContainer-light/50 dark:bg-surfaceContainer-dark/30
                       border border-outline-light/20 dark:border-outline-dark/30 shadow-sm">
                <h3 class="text-base font-semibold text-onSurface-light dark:text-onSurface-dark">Herramientas</h3>
                <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-3">
                    <SkillItem name="Git" nivel="Avanzado" />
                    <SkillItem name="GitHub" nivel="Avanzado" />
                    <SkillItem name="Visual Studio Code" nivel="Avanzado" />
                    <SkillItem name="Pycharm" nivel="Avanzado" />
                    <SkillItem name="Cursor" nivel="Avanzado" />
                    <SkillItem name="Bash" nivel="Intermedio" />
                    <SkillItem name="Ireport" icon="PDF" nivel="Avanzado" />
                    <SkillItem name="Cloudinary" icon="Cloud" nivel="Intermedio" />
                    <SkillItem name="Supabase" nivel="Avanzado" />
                    <SkillItem name="Claude Code" nivel="Intermedio" />
                    <SkillItem name="Sentry" nivel="Básico" />
                </div>
            </div>

            <div class="min-w-[16rem] md:min-w-[22rem] max-w-[28rem] min-h-[20rem] p-5 rounded-2xl overflow-hidden flex flex-col items-center snap-center
                       bg-surfaceContainer-light/50 dark:bg-surfaceContainer-dark/30
                       border border-outline-light/20 dark:border-outline-dark/30 shadow-sm">
                <h3 class="text-base font-semibold text-onSurface-light dark:text-onSurface-dark">Despliegue</h3>
                <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-3">
                    <SkillItem name="Vercel" nivel="Avanzado" />
                    <SkillItem name="Railway" nivel="Avanzado" />
                    <SkillItem name="Github Pages" icon="GitHub" nivel="Avanzado" />
                    <SkillItem name="Play Console" nivel="Avanzado" />
                    <SkillItem name="Render" nivel="Intermedio" />
                    <SkillItem name="Xcode" nivel="Intermedio" />
                </div>
            </div>

            <div class="min-w-[16rem] md:min-w-[22rem] max-w-[28rem] min-h-[20rem] p-5 rounded-2xl overflow-hidden flex flex-col items-center snap-center
                       bg-surfaceContainer-light/50 dark:bg-surfaceContainer-dark/30
                       border border-outline-light/20 dark:border-outline-dark/30 shadow-sm">
                <h3 class="text-base font-semibold text-onSurface-light dark:text-onSurface-dark">IA / LLM</h3>
                <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-3">
                    <SkillItem name="LangChain" nivel="Avanzado" />
                    <SkillItem name="LangGraph" icon="LangGraph" nivel="Intermedio" />
                    <SkillItem name="RAG" icon="RAG" nivel="Intermedio" />
                    <SkillItem name="Agents" icon="Bot" nivel="Intermedio" />
                    <SkillItem name="Tools" icon="Tools" nivel="Intermedio" />
                    <SkillItem name="Gemini" icon="Gemini" nivel="Intermedio" />
                    <SkillItem name="OpenAI" icon="OpenAI" nivel="Intermedio" />
                    <SkillItem name="Claude" nivel="Intermedio" />
                </div>
            </div>

            <div class="hidden xl:flex min-w-[12rem] max-w-[28rem] min-h-[22rem]"></div>
        </div>
        <div class="hidden xl:flex w-[24rem] h-full absolute end-[0] top-0 z-100 bg-gradient-to-l from-[rgb(249,249,255,1)] dark:from-[rgb(17,19,24,1)] to-transparent"></div>
    </div>

    <details class="mt-6 w-full text-xs text-onSurface-light/80 dark:text-onSurface-dark/80">
        <summary class="cursor-pointer font-medium">
            Créditos de iconos (icon-icons.com)
        </summary>
        <p class="mt-2">
            Atribución por autor según la licencia de icon-icons.com.
        </p>
        <p class="mt-2">
            Ver listado completo de autores aquí:
            <a class="underline hover:opacity-80" href="/static/technologies/ATTRIBUTION.md" target="_blank" rel="noopener noreferrer">
                ATTRIBUTION.md
            </a>
        </p>
    </details>
</section>

<style>
.scrollbar-hide {
    scrollbar-width: none;
    -ms-overflow-style: none; 
}

.scrollbar-hide::-webkit-scrollbar {
    display: none;
}
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const scrollContainer = document.getElementById('scroll-container');
        const btnLeft = document.getElementById('scroll-left');
        const btnRight = document.getElementById('scroll-right');
        if (!scrollContainer || !btnLeft || !btnRight) return;

        btnLeft.addEventListener('click', () => scrollContainer.scrollBy({ left: -320, behavior: 'smooth' }));
        btnRight.addEventListener('click', () => scrollContainer.scrollBy({ left: 320, behavior: 'smooth' }));
    });
</script>