---
import '../../public/icomoon/style.css'
import Title from './Title.astro'
---
<footer id="contacts" class="seccion w-full flex flex-col items-center px-6 md:px-9 pt-20 pb-12">
    <div class="w-full max-w-5xl flex flex-col items-center gap-12">
        <Title label="Contactos" dev={true} />

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 w-full max-w-3xl">
            <a
                target="_blank"
                rel="noopener noreferrer"
                href="mailto:luis.gomez.veloz@gmail.com"
                class="flex items-center gap-4 p-5 rounded-2xl overflow-hidden
                       bg-surfaceContainer-light/50 dark:bg-surfaceContainer-dark/30
                       border border-outline-light/20 dark:border-outline-dark/30
                       hover:border-secondary-light/50 hover:dark:border-secondary-dark/50
                       hover:bg-surfaceContainer-light/70 dark:hover:bg-surfaceContainer-dark/50
                       transition-all duration-200 ease-out group">
                <span class="flex shrink-0 w-12 h-12 rounded-full items-center justify-center
                             bg-secondaryContainer-light dark:bg-secondaryContainer-dark
                             text-secondary-light dark:text-secondary-dark">
                    <span class="icon-mail3 text-xl"></span>
                </span>
                <div class="min-w-0 flex-1">
                    <span class="text-xs font-medium text-outline-light dark:text-outline-dark block">Email</span>
                    <span class="text-sm text-onSurface-light dark:text-onSurface-dark truncate block group-hover:text-secondary-light group-hover:dark:text-secondary-dark transition-colors">
                        luis.gomez.veloz@gmail.com
                    </span>
                </div>
            </a>
            <a
                target="_blank"
                rel="noopener noreferrer"
                href="https://www.linkedin.com/in/luisgomez1991/"
                class="flex items-center gap-4 p-5 rounded-2xl overflow-hidden
                       bg-surfaceContainer-light/50 dark:bg-surfaceContainer-dark/30
                       border border-outline-light/20 dark:border-outline-dark/30
                       hover:border-secondary-light/50 hover:dark:border-secondary-dark/50
                       hover:bg-surfaceContainer-light/70 dark:hover:bg-surfaceContainer-dark/50
                       transition-all duration-200 ease-out group">
                <span class="flex shrink-0 w-12 h-12 rounded-full items-center justify-center
                             bg-secondaryContainer-light dark:bg-secondaryContainer-dark
                             text-secondary-light dark:text-secondary-dark">
                    <span class="icon-linkedin text-xl"></span>
                </span>
                <div class="min-w-0 flex-1">
                    <span class="text-xs font-medium text-outline-light dark:text-outline-dark block">LinkedIn</span>
                    <span class="text-sm text-onSurface-light dark:text-onSurface-dark block group-hover:text-secondary-light group-hover:dark:text-secondary-dark transition-colors">
                        /luisgomez1991
                    </span>
                </div>
            </a>
            <a
                target="_blank"
                rel="noopener noreferrer"
                href="https://wa.me/+593991718739?text=Hola%20Luis,%20he%20visto%20tu%20portafolio%20y%20me%20gustaría%20hablar%20contigo%20sobre%20una%20oportunidad%20de%20trabajo."
                class="flex items-center gap-4 p-5 rounded-2xl overflow-hidden
                       bg-surfaceContainer-light/50 dark:bg-surfaceContainer-dark/30
                       border border-outline-light/20 dark:border-outline-dark/30
                       hover:border-secondary-light/50 hover:dark:border-secondary-dark/50
                       hover:bg-surfaceContainer-light/70 dark:hover:bg-surfaceContainer-dark/50
                       transition-all duration-200 ease-out group">
                <span class="flex shrink-0 w-12 h-12 rounded-full items-center justify-center
                             bg-secondaryContainer-light dark:bg-secondaryContainer-dark
                             text-secondary-light dark:text-secondary-dark">
                    <span class="icon-whatsapp text-xl"></span>
                </span>
                <div class="min-w-0 flex-1">
                    <span class="text-xs font-medium text-outline-light dark:text-outline-dark block">WhatsApp</span>
                    <span class="text-sm text-onSurface-light dark:text-onSurface-dark block group-hover:text-secondary-light group-hover:dark:text-secondary-dark transition-colors">
                        +593 99 171 8739
                    </span>
                </div>
            </a>
        </div>

        <span class="text-xs text-outline-light dark:text-outline-dark text-center">
            Copyright © 2025 Luis Gómez. Todos los derechos reservados.
        </span>
    </div>
</footer>