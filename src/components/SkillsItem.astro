---
import { Icon } from 'astro-icon/components'
import { brandColor } from '../lib/brand'

interface Props {
	name: string;
	/** Nombre Iconify: 'simple-icons:<slug>' para marcas, 'ph:<nombre>' para conceptos. */
	icon: string;
}

const { name, icon } = Astro.props;
const color = brandColor(icon);
---

<li class="inline-flex items-center gap-2 py-1.5 pl-1.5 pr-3 rounded-full
           bg-surface-light/60 dark:bg-surface-dark/30
           border border-outline-light/15 dark:border-outline-dark/25">
	<span class="shrink-0 w-6 h-6 rounded-full
	             bg-surfaceContainer-light dark:bg-[#e8eaf0] text-[#1d2433]
	             flex items-center justify-center">
		<Icon name={icon} class="w-3.5 h-3.5" style={color ? `color:${color}` : undefined} aria-hidden="true" />
	</span>
	<span class="text-sm text-onSurface-light dark:text-onSurface-dark whitespace-nowrap">{name}</span>
</li>
