---
interface Props {
	name: string;
    nivel: string;
    icon?: string;
}

const { name, nivel, icon } = Astro.props;
const iconName = icon ?? name;

const nivelColor = nivel === 'Avanzado' 
    ? 'text-onSurface-light dark:text-onSurface-dark' 
    : nivel === 'Intermedio' 
        ? 'text-outline-light dark:text-outline-dark' 
        : 'text-outline-light/80 dark:text-outline-dark/80';
---

<div class="flex items-center gap-3 w-full py-2 px-3 rounded-xl
            bg-surface-light/60 dark:bg-surface-dark/30
            border border-outline-light/10 dark:border-outline-dark/20">
    <div class="shrink-0 w-9 h-9 rounded-lg overflow-hidden
                bg-surfaceContainer-light dark:bg-[#e8eaf0]
                flex items-center justify-center">
        <img
            src={`/static/technologies/${encodeURIComponent(iconName)}.svg`}
            alt={name}
            class="w-6 h-6 object-contain"
            onerror="if (this.dataset.fallback !== '1') { this.dataset.fallback = '1'; this.src = this.src.replace('.svg','.png'); } else { this.style.display='none'; }"
        >
    </div>
    <div class="flex flex-col min-w-0 flex-1">
        <p class="m-0 text-sm font-medium text-onSurface-light dark:text-onSurface-dark truncate">{name}</p>
        <span class={`m-0 text-xs ${nivelColor}`}>{nivel}</span>
    </div>
</div>

    
