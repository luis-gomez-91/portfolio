---
interface Props {
	name: string;
}

const { name } = Astro.props;
---

<span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium
             bg-secondaryContainer-light/80 dark:bg-secondaryContainer-dark/60
             text-secondary-light dark:text-secondary-dark
             border border-outline-light/15 dark:border-outline-dark/20">
	{name}
</span>
