---
import { ViewTransitions } from 'astro:transitions';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="flex flex-col justify-center items-center">
	<head>
		<meta charset="UTF-8" />
		<script is:inline>
			(function(){
				try {
					var s = localStorage.getItem('theme');
					var d = window.matchMedia('(prefers-color-scheme: dark)').matches;
					var dark = s === 'dark' || (s !== 'light' && d);
					document.documentElement.classList.toggle('dark', dark);
				} catch (e) {
					document.documentElement.classList.toggle('dark', window.matchMedia('(prefers-color-scheme: dark)').matches);
				}
			})();
		</script>
		<meta name="description" content="Luis Gómez - Desarrollador Full-Stack. Portafolio con proyectos web, APIs y apps móviles. Django, Laravel, Astro, Kotlin, Kotlin Multiplatform." />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
		<link rel="icon" type="image/png" href="/static/logo.png" />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content="Luis Gómez - Desarrollador Full-Stack. Portafolio con proyectos web, APIs y apps móviles." />
		<meta property="og:image" content="/static/nerd.webp" />
		<meta property="og:locale" content="es_ES" />
		<title>{title}</title>
		<!-- <ViewTransitions /> -->
		<style>
			@import url('https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=SUSE:wght@100..800&display=swap');
		</style>
	</head>
	<script is:inline src="https://cdn.jsdelivr.net/npm/flowbite@2.5.1/dist/flowbite.min.js"></script>
	<body class="m-0 p-0 pb-9 transition duration-500 ease-in-out 
				font-poppins font-normal w-screen
				text-outline-light dark:text-outline-dark
				bg-surface-light dark:bg-surface-dark bg-gradient-subtle">
		<header id="inicio" class="relative flex flex-col items-center justify-center">
			<Navigation />
		</header>
		<slot />	
		<Footer />
	</body>
</html>

