---
import { ViewTransitions } from 'astro:transitions';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	/** Imagen para la vista previa al compartir (ruta dentro de /public). */
	image?: string;
	type?: 'website' | 'article';
}

const DEFAULT_DESCRIPTION = 'Luis Gómez - Full-Stack & AI Engineer. Portafolio con proyectos web, APIs y apps móviles. Django, Nestjs, Nextjs, Sveltkit, Astro, Kotlin, Kotlin Multiplatform.';
const { title, description = DEFAULT_DESCRIPTION, image = '/static/nerd.webp', type = 'website' } = Astro.props;
// Las redes necesitan URLs absolutas: solo se pueden armar si `site` está en astro.config.mjs.
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const ogImage = absolute(image);
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="es" class="flex flex-col justify-center items-center">
	<head>
		<meta charset="UTF-8" />
		<script is:inline>
			(function () {
				function getTheme() {
					try {
						var s = localStorage.getItem('theme');
						if (s === 'dark' || s === 'light') return s;
					} catch (e) {}
					return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				}
				function applyTheme(theme) {
					document.documentElement.classList.toggle('dark', theme === 'dark');
				}
				applyTheme(getTheme());
				document.addEventListener('astro:after-swap', function () {
					applyTheme(getTheme());
				});
			})();
		</script>
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		{canonical && <link rel="canonical" href={canonical} />}
		{canonical && <meta property="og:url" content={canonical} />}
		<meta property="og:locale" content="es_ES" />
		<title>{title}</title>
		<ViewTransitions />
		<style>
			@import url('https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=SUSE:wght@100..800&display=swap');
		</style>
	</head>
	<script is:inline src="https://cdn.jsdelivr.net/npm/flowbite@2.5.1/dist/flowbite.min.js"></script>
	<body class="m-0 p-0 pb-9 transition duration-500 ease-in-out 
				font-poppins font-normal w-screen
				text-outline-light dark:text-outline-dark
				bg-surface-light dark:bg-surface-dark bg-gradient-subtle">
		<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-secondary-light focus:text-secondaryContainer-light dark:focus:bg-secondary-dark dark:focus:text-secondaryContainer-dark focus:outline-none">
			Saltar al contenido
		</a>
		<header id="inicio" class="relative flex flex-col items-center justify-center" transition:persist="site-header">
			<Navigation />
		</header>
		<div id="main-content" transition:animate="fade">
			<slot />
		</div>
		<Footer />
	</body>
</html>

<script>
	document.addEventListener('astro:page-load', () => {
		const sections = document.querySelectorAll('.fade-in, .stagger');

		// Escalonado: cada hijo de .stagger entra un poco después que el anterior.
		document.querySelectorAll('.stagger').forEach(group => {
			Array.from(group.children).forEach((child, i) => {
				child.style.setProperty('--stagger-i', String(i));
			});
		});

		const observer = new IntersectionObserver(entries => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					entry.target.classList.add('visible');
					observer.unobserve(entry.target);
				}
			});
		}, { threshold: 0.15 });

		sections.forEach(section => {
			observer.observe(section);
		});

		// Inclinación 3D + brillo que sigue al cursor en tarjetas [data-tilt].
		const canTilt = window.matchMedia('(pointer: fine)').matches
			&& !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (canTilt) {
			document.querySelectorAll('[data-tilt]').forEach(card => {
				if (card.dataset.tiltBound) return;
				card.dataset.tiltBound = '1';
				const MAX = 5;
				card.addEventListener('pointermove', e => {
					const r = card.getBoundingClientRect();
					const x = (e.clientX - r.left) / r.width;
					const y = (e.clientY - r.top) / r.height;
					card.style.setProperty('--glow-x', `${x * 100}%`);
					card.style.setProperty('--glow-y', `${y * 100}%`);
					card.style.transform = `perspective(900px) rotateX(${(0.5 - y) * MAX}deg) rotateY(${(x - 0.5) * MAX}deg) translateY(-2px)`;
				});
				card.addEventListener('pointerleave', () => {
					card.style.transform = '';
				});
			});
		}

		document.querySelectorAll('a[href^="#"]').forEach(anchor => {
			if (anchor.dataset.smoothBound) return;
			anchor.dataset.smoothBound = '1';
			anchor.addEventListener('click', function (e) {
				const href = this.getAttribute('href');
				if (!href || href === '#') return;
				const target = document.querySelector(href);
				if (!target) return;
				e.preventDefault();
				if (window.location.hash !== href) {
					history.pushState(null, '', href);
					window.dispatchEvent(new Event('hashchange'));
				}
				target.scrollIntoView({
					behavior: 'smooth',
					block: 'start'
				});
			});
		});
	});
</script>

<style is:global>
	.fade-in {
		opacity: 0;
		transform: translateY(24px);
		transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.fade-in.visible {
		opacity: 1;
		transform: none;
	}

	.stagger > * {
		opacity: 0;
		transform: translateY(18px);
		transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1), transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
		transition-delay: calc(var(--stagger-i, 0) * 90ms + 100ms);
	}
	.stagger.visible > * {
		opacity: 1;
		transform: none;
	}

	.tilt-card {
		transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease-out, border-color 0.3s ease-out;
		transform-style: preserve-3d;
	}
	.tilt-glow {
		background: radial-gradient(420px circle at var(--glow-x, 50%) var(--glow-y, 50%), rgb(255 255 255 / 0.12), transparent 45%);
	}
	html:not(.dark) .tilt-glow {
		background: radial-gradient(420px circle at var(--glow-x, 50%) var(--glow-y, 50%), rgb(80 110 200 / 0.10), transparent 45%);
	}
	.tilt-card:hover .tilt-glow {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.fade-in,
		.stagger > * {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}

	/* Origen del proyecto: personal, freelance o laboral. */
	.kind-dot {
		display: inline-block;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 9999px;
		flex-shrink: 0;
	}
	.kind-dot-propio { background: #415f91; }
	.kind-dot-freelance { background: #2e7d5b; }
	.kind-dot-laboral { background: #8e9099; }
	html.dark .kind-dot-propio { background: #aac7ff; }
	html.dark .kind-dot-freelance { background: #7fd3a8; }
</style>

<style>
	html {
		scroll-behavior: smooth;
	}

	.fast-scroll {
		scroll-behavior: smooth;
		scroll-timing-function: ease-in-out;
		transition-duration: 0.8s;
	}

	.bg-gradient-subtle {
		background-image: linear-gradient(135deg, #f9f9ff 0%, #f5f6ff 50%, #f8f7fc 100%);
	}
	html.dark .bg-gradient-subtle {
		background-image: linear-gradient(135deg, #1a1d24 0%, #171a21 50%, #1e222a 100%);
	}
</style>