---
import Layout from '../layouts/Layout.astro';
import ProjectItem from '../components/ProjectItem.astro';
import { FILTERS, LEGACY_FILTERS, getProjectGroups, groupFilters } from '../lib/projects';

const groups = await getProjectGroups();
const cards = groups.map((group) => ({ group, filters: groupFilters(group) }));

// Solo se muestran filtros con al menos un proyecto.
const tabs = [
	{ id: 'all', label: 'Todos', count: groups.length },
	...FILTERS.map((f) => ({ id: f.id, label: f.label, count: cards.filter((c) => c.filters.includes(f.id)).length })),
].filter((t) => t.count > 0);

const filterConfig = { valid: tabs.map((t) => t.id), legacy: LEGACY_FILTERS };
---

<Layout title="Luis Gómez - Proyectos">
	<main class="flex flex-col items-center w-full px-6 md:px-9 pt-28 pb-20">
		<section class="w-full max-w-6xl flex flex-col items-center gap-8">
			<h1 class="sr-only">Proyectos</h1>

			<div
				class="filter-tabs w-full flex flex-nowrap md:flex-wrap justify-start md:justify-center gap-2
				       overflow-x-auto overscroll-x-contain touch-pan-x
				       -mx-6 px-6 md:mx-0 md:px-0"
				role="group"
				aria-label="Filtrar proyectos"
				data-config={JSON.stringify(filterConfig)}>
				{tabs.map((tab, i) => (
					<button
						type="button"
						class:list={[
							'filter-tab shrink-0 inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium',
							'text-outline-light dark:text-outline-dark border border-outline-light/40 dark:border-outline-dark/40',
							'hover:text-onSurface-light hover:dark:text-onSurface-dark',
							'hover:bg-secondary-light/20 hover:dark:bg-secondary-dark/20 hover:border-secondary-light hover:dark:border-secondary-dark',
							'transition-colors duration-200 cursor-pointer',
							i === 0 && 'filter-tab-active',
						]}
						data-filter={tab.id}
						aria-pressed={i === 0 ? 'true' : 'false'}>
						<span>{tab.label}</span>
						<span class="filter-count text-xs tabular-nums opacity-70">{tab.count}</span>
					</button>
				))}
			</div>

			<p id="projects-status" class="sr-only" role="status" aria-live="polite"></p>

			<div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 w-full">
				{cards.map(({ group, filters }) => (
					<article class="project-card" data-filters={filters.join(' ')}>
						<ProjectItem group={group} />
					</article>
				))}
			</div>
			<p id="projects-empty" class="hidden text-center text-sm text-outline-light dark:text-outline-dark py-12">
				No hay proyectos en esta categoría.
			</p>
		</section>
	</main>
</Layout>

<script>
	document.addEventListener('astro:page-load', () => {
		const STORAGE_KEY = 'projects-filter';
		const bar = document.querySelector<HTMLElement>('.filter-tabs');
		if (!bar) return;

		const { valid, legacy } = JSON.parse(bar.dataset.config || '{}') as { valid: string[]; legacy: Record<string, string> };
		const tabs = bar.querySelectorAll<HTMLButtonElement>('.filter-tab');
		const cards = document.querySelectorAll<HTMLElement>('.project-card');
		const empty = document.getElementById('projects-empty');
		const status = document.getElementById('projects-status');
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		const normalize = (f: string | null) => {
			const id = f ? legacy[f] ?? f : 'all';
			return valid.includes(id) ? id : 'all';
		};

		const applyFilter = (filter: string | null, animate = true) => {
			const active = normalize(filter);
			let label = '';

			tabs.forEach((tab) => {
				const isActive = tab.dataset.filter === active;
				tab.classList.toggle('filter-tab-active', isActive);
				tab.setAttribute('aria-pressed', String(isActive));
				if (isActive) {
					label = tab.querySelector('span')?.textContent ?? '';
					if (animate && window.matchMedia('(max-width: 767px)').matches) {
						tab.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
					}
				}
			});

			let visible = 0;
			cards.forEach((card) => {
				const show = active === 'all' || (card.dataset.filters || '').split(' ').includes(active);
				card.classList.toggle('hidden', !show);
				if (show) {
					visible++;
					if (animate && !reduceMotion) {
						card.classList.remove('card-enter');
						void card.offsetWidth;
						card.style.setProperty('--enter-i', String(visible - 1));
						card.classList.add('card-enter');
					}
				}
			});

			empty?.classList.toggle('hidden', visible > 0);
			if (status) status.textContent = `${visible} proyectos en ${label}`;

			try {
				sessionStorage.setItem(STORAGE_KEY, active);
			} catch {}

			const url = new URL(window.location.href);
			if (active === 'all') url.searchParams.delete('filter');
			else url.searchParams.set('filter', active);
			history.replaceState(history.state, '', url);
		};

		tabs.forEach((tab) => {
			if (tab.dataset.filterBound) return;
			tab.dataset.filterBound = '1';
			tab.addEventListener('click', () => applyFilter(tab.dataset.filter ?? 'all'));
		});

		const fromUrl = new URLSearchParams(window.location.search).get('filter');
		let fromStorage: string | null = null;
		try {
			fromStorage = sessionStorage.getItem(STORAGE_KEY);
		} catch {}

		applyFilter(fromUrl || fromStorage, false);
	});
</script>

<style>
	.filter-tabs {
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
	}
	.filter-tabs::-webkit-scrollbar {
		display: none;
	}

	@media (min-width: 768px) {
		.filter-tabs {
			overflow-x: visible;
		}
	}

	.filter-tab-active {
		background-color: #565f71 !important;
		color: #dae2f9 !important;
		border-color: transparent !important;
	}
	:global(html.dark) .filter-tab-active {
		background-color: #bec6dc !important;
		color: #3e4759 !important;
		border-color: transparent !important;
	}

	.card-enter {
		animation: card-enter 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: calc(min(var(--enter-i, 0), 8) * 40ms);
	}
	@keyframes card-enter {
		from {
			opacity: 0;
			transform: translateY(12px) scale(0.98);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
</style>
