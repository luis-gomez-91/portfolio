---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { demoLink, findGroup, getProjectGroups, groupTechnologies, metaLine, placeholderHue, placeholderIcon } from '../lib/projects';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: { id: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { slug, data } = project;
const { title, description, technologies, images, previewLink, githubLink, features, areas = [] } = data;
const { Content } = await render(project);

const groups = await getProjectGroups();
const group = findGroup(groups, slug)!;
const parts = group.parts;
const multi = parts.length > 1;
const meta = metaLine(project);
const demo = previewLink ? demoLink(previewLink, areas) : null;
const techGroups = groupTechnologies(technologies);

// Vista previa al compartir: descripción corta y primera captura.
const firstParagraph = description.trim().split(/\n\s*\n/)[0].replace(/\s+/g, ' ');
const shareDescription = firstParagraph.length > 160
  ? `${firstParagraph.slice(0, 157).replace(/\s+\S*$/, '')}…`
  : firstParagraph || undefined;
const shareImage = images[0];

// Anterior / siguiente entre productos (las piezas del mismo producto no cuentan).
const index = groups.indexOf(group);
const prev = groups[(index - 1 + groups.length) % groups.length];
const next = groups[(index + 1) % groups.length];

// Layout de la galería según cuántas capturas hay, para no dejar huecos.
const shown = images.slice(0, 5);
const layout = {
  1: { grid: 'grid-cols-1', main: '', thumb: '' },
  2: { grid: 'grid-cols-2', main: '', thumb: '' },
  3: { grid: 'grid-cols-2 sm:grid-cols-3', main: 'col-span-2 sm:row-span-2', thumb: '' },
  4: { grid: 'grid-cols-3', main: 'col-span-3', thumb: '' },
  5: { grid: 'grid-cols-2 lg:grid-cols-4', main: 'col-span-2 lg:row-span-2', thumb: '' },
}[shown.length as 1 | 2 | 3 | 4 | 5];
---

<Layout title={`Luis Gómez - ${multi ? `${group.title} · ${data.part ?? title}` : title}`} description={shareDescription} image={shareImage} type="article">
	<main class="flex flex-col items-center w-full px-6 md:px-9 pt-28 pb-20">
    <div class="w-full max-w-5xl flex flex-col gap-6">
      <a href="/projects" class="inline-flex items-center gap-2 text-sm text-outline-light dark:text-outline-dark hover:text-secondary-light hover:dark:text-secondary-dark transition-colors w-fit">
        <Icon name="ph:arrow-left" class="w-4 h-4" aria-hidden="true" />
        Volver a Proyectos
      </a>

      {multi && (
        <nav aria-label={`Piezas de ${group.title}`} class="flex flex-col gap-2">
          <p class="text-xs font-medium uppercase tracking-wide text-outline-light dark:text-outline-dark">
            {group.title} · {parts.length} piezas
          </p>
          <div class="part-switch inline-flex flex-wrap gap-1 p-1 w-fit rounded-full bg-surfaceContainer-light/70 dark:bg-surfaceContainer-dark/50 border border-outline-light/20 dark:border-outline-dark/30">
            {parts.map((p) => {
              const active = p.slug === slug;
              return (
                <a
                  href={`/${p.slug}`}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'px-4 py-1.5 rounded-full text-sm font-medium transition-colors duration-200',
                    active
                      ? 'bg-secondary-light dark:bg-secondary-dark text-secondaryContainer-light dark:text-secondaryContainer-dark shadow-sm'
                      : 'text-outline-light dark:text-outline-dark hover:text-onSurface-light hover:dark:text-onSurface-dark',
                  ]}>
                  {p.data.part ?? p.data.title}
                </a>
              );
            })}
          </div>
        </nav>
      )}

      <article class="flex flex-col gap-6 p-6 md:p-8 rounded-2xl overflow-hidden
                     bg-surfaceContainer-light/50 dark:bg-surfaceContainer-dark/30
                     border border-outline-light/20 dark:border-outline-dark/30 shadow-sm">
        {shown.length > 0 ? (
          <div class="project-gallery -mx-6 -mt-6 md:-mx-8 md:-mt-8 mb-2" data-images={JSON.stringify(images)} data-title={title}>
            <div class:list={['grid gap-2 p-4 md:p-6 pt-4', layout.grid]}>
              {shown.map((image, i) => {
                const isMain = i === 0;
                const span = isMain ? layout.main : layout.thumb;
                return (
                  <button
                    type="button"
                    class:list={['gallery-item group/img block w-full overflow-hidden rounded-xl cursor-zoom-in focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary-light dark:focus-visible:outline-secondary-dark', span]}
                    data-index={i}
                    aria-label={`Ampliar imagen ${i + 1} de ${images.length}`}>
                    <span class="relative block w-full h-full aspect-[3/2]">
                      <img src={image} alt={isMain ? `Captura principal de ${title}` : `Captura ${i + 1} de ${title}`}
                        width={isMain ? 800 : 400} height={isMain ? 534 : 267}
                        loading={isMain ? 'eager' : 'lazy'} decoding="async"
                        transition:name={isMain ? `project-image-${slug}` : undefined}
                        class="object-cover w-full h-full transition-transform duration-500 group-hover/img:scale-105" />
                      {i === shown.length - 1 && images.length > shown.length && (
                        <span class="absolute inset-0 flex items-center justify-center bg-black/50 text-white text-lg font-semibold">
                          +{images.length - shown.length}
                        </span>
                      )}
                    </span>
                  </button>
                );
              })}
            </div>
          </div>
        ) : (
          <div
            class="project-placeholder -mx-6 -mt-6 md:-mx-8 md:-mt-8 mb-2 aspect-[21/9] flex flex-col items-center justify-center gap-3 p-6 text-center"
            style={`--ph-hue: ${placeholderHue(group.key)}`}
            transition:name={`project-image-${slug}`}
            aria-hidden="true">
            <Icon name={placeholderIcon(areas)} class="w-14 h-14 opacity-80" />
            <span class="font-suse font-bold text-2xl md:text-3xl">{multi ? group.title : title}</span>
          </div>
        )}

        <header>
          {meta && (
            <p class="mb-2 inline-flex items-center gap-1.5 text-xs font-medium uppercase tracking-wide text-tertiary-light dark:text-tertiary-dark">
              {data.kind && <span class:list={['kind-dot', `kind-dot-${data.kind}`]} aria-hidden="true"></span>}
              {meta}
            </p>
          )}
          <h1 transition:name={`project-title-${slug}`} class="text-2xl md:text-3xl font-bold text-onSurface-light dark:text-onSurface-dark">{title}</h1>
        </header>

        {description.trim() && (
          <p class="text-sm md:text-base leading-relaxed text-onSurface-light dark:text-onSurface-dark whitespace-pre-line">{description.trim()}</p>
        )}

        {features && features.length > 0 && (
          <div class="pt-4 border-t border-outline-light/10 dark:border-outline-dark/10">
            <h2 class="text-base font-semibold text-onSurface-light dark:text-onSurface-dark mb-3">Características</h2>
            <ul class="space-y-2">
              {features.map((feature) => (
                <li class="flex items-start gap-3 text-sm text-onSurface-light dark:text-onSurface-dark">
                  <Icon name="ph:check-circle" class="w-5 h-5 text-secondary-light dark:text-secondary-dark shrink-0" aria-hidden="true" />
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {techGroups.length > 0 && (
          <div class="pt-4 border-t border-outline-light/10 dark:border-outline-dark/10">
            <h2 class="text-base font-semibold text-onSurface-light dark:text-onSurface-dark mb-3">Tecnologías</h2>
            <dl class="grid grid-cols-1 sm:grid-cols-[8rem_1fr] gap-x-4 gap-y-3">
              {techGroups.map(({ label, items }) => (
                <>
                  <dt class="text-xs font-medium uppercase tracking-wide text-outline-light dark:text-outline-dark sm:pt-1">{label}</dt>
                  <dd class="flex flex-wrap gap-1.5">
                    {items.map((tech) => (
                      <span class="px-2 py-0.5 rounded-md text-xs bg-secondaryContainer-light dark:bg-secondaryContainer-dark text-secondary-light dark:text-secondary-dark">{tech}</span>
                    ))}
                  </dd>
                </>
              ))}
            </dl>
          </div>
        )}

        {(demo || githubLink) && (
          <div class="flex flex-wrap gap-2 pt-4 border-t border-outline-light/10 dark:border-outline-dark/10">
            {demo && (
              <a href={previewLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 h-11 px-5 rounded-full text-sm font-medium text-secondaryContainer-light dark:text-secondaryContainer-dark bg-secondary-light dark:bg-secondary-dark hover:bg-secondary-light/90 hover:dark:bg-secondary-dark/90 transition-all duration-200">
                <Icon name={demo.icon} class="w-[18px] h-[18px]" aria-hidden="true" />
                <span>{demo.label}</span>
                <span class="sr-only">(se abre en otra pestaña)</span>
              </a>
            )}
            {githubLink && (
              <a href={githubLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 h-11 px-5 rounded-full text-sm font-medium text-secondary-light dark:text-secondary-dark bg-transparent border border-secondary-light/60 dark:border-secondary-dark/60 hover:bg-secondary-light/15 hover:dark:bg-secondary-dark/15 hover:border-secondary-light hover:dark:border-secondary-dark transition-all duration-200">
                <Icon name="simple-icons:github" class="w-[18px] h-[18px]" aria-hidden="true" />
                <span>Ver código</span>
                <span class="sr-only">(se abre en otra pestaña)</span>
              </a>
            )}
          </div>
        )}

        <div class="prose-project empty:hidden pt-6 border-t border-outline-light/10 dark:border-outline-dark/10 text-onSurface-light dark:text-onSurface-dark text-sm md:text-base leading-relaxed"><Content /></div>
      </article>

      {groups.length > 1 && (
        <nav aria-label="Más proyectos" class="grid grid-cols-2 gap-3">
          {[{ g: prev, dir: 'prev' }, { g: next, dir: 'next' }].map(({ g, dir }) => (
            <a href={`/${g.primary.slug}`}
               class:list={['group flex flex-col gap-1 p-4 md:p-5 rounded-2xl border border-outline-light/20 dark:border-outline-dark/30 bg-surfaceContainer-light/30 dark:bg-surfaceContainer-dark/20 hover:border-secondary-light/50 hover:dark:border-secondary-dark/50 transition-colors', dir === 'next' && 'items-end text-right']}>
              <span class="inline-flex items-center gap-1.5 text-xs text-outline-light dark:text-outline-dark">
                {dir === 'prev' && <Icon name="ph:arrow-left" class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" aria-hidden="true" />}
                {dir === 'prev' ? 'Anterior' : 'Siguiente'}
                {dir === 'next' && <Icon name="ph:arrow-right" class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />}
              </span>
              <span class="text-sm md:text-base font-semibold text-onSurface-light dark:text-onSurface-dark line-clamp-2">{g.title}</span>
            </a>
          ))}
        </nav>
      )}
    </div>

    {images.length > 0 && (
      <div id="project-lightbox" class="lightbox hidden fixed inset-0 z-50 bg-black/85 flex items-center justify-center px-4"
           role="dialog" aria-modal="true" aria-label={`Galería de ${title}`}>
        <button id="lightbox-close" type="button" class="absolute top-4 right-4 w-11 h-11 flex items-center justify-center rounded-full bg-black/40 hover:bg-black/60 text-white z-10 transition-colors" aria-label="Cerrar galería">
          <Icon name="ph:x" class="w-6 h-6" aria-hidden="true" />
        </button>
        {images.length > 1 && (
          <>
            <button id="lightbox-prev" type="button" class="absolute left-2 md:left-10 top-1/2 -translate-y-1/2 w-12 h-12 flex items-center justify-center rounded-full bg-black/40 hover:bg-black/60 text-white z-10 transition-colors" aria-label="Imagen anterior">
              <Icon name="ph:caret-left" class="w-6 h-6" aria-hidden="true" />
            </button>
            <button id="lightbox-next" type="button" class="absolute right-2 md:right-10 top-1/2 -translate-y-1/2 w-12 h-12 flex items-center justify-center rounded-full bg-black/40 hover:bg-black/60 text-white z-10 transition-colors" aria-label="Imagen siguiente">
              <Icon name="ph:caret-right" class="w-6 h-6" aria-hidden="true" />
            </button>
          </>
        )}
        <figure class="max-w-5xl w-full">
          <img id="lightbox-image" src="" alt="" class="w-full h-auto max-h-[85vh] object-contain rounded-lg select-none" draggable="false" />
          <figcaption id="lightbox-caption" class="mt-4 text-center text-sm text-white/90" aria-live="polite"></figcaption>
        </figure>
      </div>
    )}
	</main>
</Layout>

<style>
  .project-placeholder {
    color: hsl(var(--ph-hue) 35% 30%);
    background:
      radial-gradient(circle at 20% 15%, hsl(var(--ph-hue) 70% 88%), transparent 55%),
      radial-gradient(circle at 85% 90%, hsl(calc(var(--ph-hue) + 40) 60% 85%), transparent 50%),
      hsl(var(--ph-hue) 40% 93%);
  }
  :global(html.dark) .project-placeholder {
    color: hsl(var(--ph-hue) 60% 85%);
    background:
      radial-gradient(circle at 20% 15%, hsl(var(--ph-hue) 45% 30%), transparent 55%),
      radial-gradient(circle at 85% 90%, hsl(calc(var(--ph-hue) + 40) 40% 25%), transparent 50%),
      hsl(var(--ph-hue) 25% 18%);
  }
  /* Texto del caso de estudio (cuerpo del .md). */
  .prose-project :global(h2) { font-size: 1.125rem; font-weight: 600; margin: 1.75rem 0 0.5rem; }
  .prose-project :global(h2:first-child) { margin-top: 0; }
  .prose-project :global(h3) { font-size: 1rem; font-weight: 600; margin: 1.25rem 0 0.4rem; }
  .prose-project :global(p) { margin: 0.6rem 0; }
  .prose-project :global(ul) { list-style: disc; padding-left: 1.25rem; margin: 0.6rem 0; }
  .prose-project :global(ol) { list-style: decimal; padding-left: 1.25rem; margin: 0.6rem 0; }
  .prose-project :global(li) { margin: 0.25rem 0; }
  .prose-project :global(strong) { font-weight: 600; }
  .prose-project :global(a) { text-decoration: underline; text-underline-offset: 3px; }
  .prose-project :global(code) { font-size: 0.85em; padding: 0.1rem 0.35rem; border-radius: 0.35rem; background: rgb(116 119 127 / 0.15); }
  .prose-project :global(img) { border-radius: 0.75rem; margin: 1rem 0; }

  /* El botón de la imagen principal llena las filas que abarca. */
  .gallery-item > span { height: 100%; }
</style>

<script>
    document.addEventListener('astro:page-load', () => {
      const gallery = document.querySelector<HTMLElement>('.project-gallery');
      const lightbox = document.getElementById('project-lightbox');
      const lightboxImg = document.getElementById('lightbox-image') as HTMLImageElement | null;
      const caption = document.getElementById('lightbox-caption');
      if (!gallery || !lightbox || !lightboxImg || !caption) return;
      if (gallery.dataset.lightboxBound) return;
      gallery.dataset.lightboxBound = '1';

      const images: string[] = JSON.parse(gallery.dataset.images || '[]');
      const title = gallery.dataset.title || '';
      const btnClose = document.getElementById('lightbox-close');
      const btnPrev = document.getElementById('lightbox-prev');
      const btnNext = document.getElementById('lightbox-next');

      let current = 0;
      let opener: HTMLElement | null = null;
      const isOpen = () => !lightbox.classList.contains('hidden');

      const show = (index: number) => {
        current = (index + images.length) % images.length;
        lightboxImg.src = images[current];
        lightboxImg.alt = `Captura ${current + 1} de ${title}`;
        caption.textContent = `${title} (${current + 1}/${images.length})`;
      };

      const open = (index: number) => {
        opener = document.activeElement as HTMLElement | null;
        show(index);
        lightbox.classList.remove('hidden');
        lightbox.offsetHeight;
        lightbox.classList.add('lightbox-visible');
        document.body.classList.add('overflow-hidden');
        btnClose?.focus();
      };

      const close = () => {
        if (!isOpen()) return;
        lightbox.classList.remove('lightbox-visible');
        const hide = () => lightbox.classList.add('hidden');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) hide();
        else lightbox.addEventListener('transitionend', hide, { once: true });
        document.body.classList.remove('overflow-hidden');
        opener?.focus();
      };

      gallery.querySelectorAll<HTMLElement>('.gallery-item').forEach((item) => {
        item.addEventListener('click', () => open(Number(item.dataset.index) || 0));
      });

      btnClose?.addEventListener('click', close);
      btnPrev?.addEventListener('click', (e) => { e.stopPropagation(); show(current - 1); });
      btnNext?.addEventListener('click', (e) => { e.stopPropagation(); show(current + 1); });
      lightbox.addEventListener('click', (e) => { if (e.target === lightbox) close(); });

      // Teclado: flechas, Escape y foco atrapado dentro del diálogo.
      lightbox.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowLeft' && images.length > 1) { e.preventDefault(); show(current - 1); }
        else if (e.key === 'ArrowRight' && images.length > 1) { e.preventDefault(); show(current + 1); }
        else if (e.key === 'Tab') {
          const focusables = Array.from(lightbox.querySelectorAll<HTMLElement>('button'));
          const first = focusables[0];
          const last = focusables[focusables.length - 1];
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        }
      });

      // Swipe en móvil.
      let startX = 0;
      let startY = 0;
      lightbox.addEventListener('touchstart', (e) => {
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
      }, { passive: true });
      lightbox.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - startX;
        const dy = e.changedTouches[0].clientY - startY;
        if (images.length > 1 && Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(current + (dx < 0 ? 1 : -1));
        else if (dy > 90 && Math.abs(dy) > Math.abs(dx)) close();
      });

      // Al navegar a otra página con la galería abierta, se libera el scroll.
      document.addEventListener('astro:before-swap', () => document.body.classList.remove('overflow-hidden'), { once: true });
    });
  </script>
  <style is:global>
    #project-lightbox{ opacity:0; transform:scale(0.97); transition:opacity .25s ease, transform .25s ease; }
    #project-lightbox.lightbox-visible{ opacity:1; transform:scale(1); }
    @media (prefers-reduced-motion: reduce){ #project-lightbox{ transition:none; } }
  </style>
