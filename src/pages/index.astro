---
import Layout from '../layouts/Layout.astro';
import Info from '../components/Info.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import SoftSkills from '../components/SoftSkills.astro';
import Title from '../components/Title.astro';
---

<Layout title="Luis Gómez - Portafolio web">
	<main class="flex flex-col items-center justify-center">
		<Info />
		<Projects />
		<About />
		<Skills />
		<section id="soft-skills" class="seccion flex flex-col justify-center items-center w-full max-w-5xl px-6 md:px-9 mt-4 mb-16 fade-in gap-8">
			<div class="flex flex-col items-center gap-2 text-center">
				<Title label="Cómo trabajo" dev={false} />
				<p class="text-sm md:text-base text-outline-light dark:text-outline-dark max-w-lg">
					Formas de trabajar que aplico en cada proyecto.
				</p>
			</div>
			<div class="flex flex-row flex-wrap justify-center gap-3">
				<SoftSkills name="Resolución de problemas" />
				<SoftSkills name="Aprendizaje continuo" />
				<SoftSkills name="Comunicación técnica clara" />
				<SoftSkills name="Responsabilidad de extremo a extremo" />
				<SoftSkills name="Orientación a resultados" />
				<SoftSkills name="Atención al detalle" />
			</div>
		</section>
	</main>
</Layout>
